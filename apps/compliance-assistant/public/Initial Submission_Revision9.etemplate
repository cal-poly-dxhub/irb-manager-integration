          {
            "dataId": 3862941,
            "name": "Group98",
            "text": "<strong>Drug, Biologics, Food, and Cosmetics&nbsp;</strong>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862887,
                "type": "displayed"
              },
              {
                "targetId": 3862899,
                "type": "displayed"
              },
              {
                "targetId": 3862908,
                "type": "displayed"
              },
              {
                "targetId": 3862909,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862942,
                "name": "TextArea51",
                "text": "<strong>Drug/Biologic/Food/Cosmetic Description</strong>",
                "description": "<em>Describe the Drugs/Biologics/Foods/Cosmetic products required/specified to be used in this project. Include:<br><ul><li><em>Name of product&nbsp;<em> / Common and/or Proprietary Name of the medical drug.</em></em></li><li><em><em>Manufacturer. (If you are building or developing the drug, indicate it here)<br></em></em></li><li><em>Purpose of intended&nbsp;use</em>(Will you test for Safety and/or Effectiveness?)&nbsp;</li><li><em>For each product, if it is (1) Intended for use in the diagnosis, cure, mitigation, treatment, or prevention of disease; AND/OR (2) I</em><em>ntended to affect the structure or any function of the body of human participants.</em></li></ul></em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "textarea"
              },
              {
                "dataId": 3862943,
                "name": "Group96",
                "text": "<strong>Insurance Billing</strong>",
                "description": "<em>Will the drug or biologic be billed to the subject or their insurance carrier?</em>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "children": [
                  {
                    "dataId": 3862944,
                    "name": "Radio37",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio",
                    "children": [
                      {
                        "dataId": 3862945,
                        "name": "AttachButton31",
                        "text": "<strong>FDA Insurance Letter</strong>",
                        "description": "<em>Attach the FDA letter which approves charging for this product.</em>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "attachment"
                      }
                    ]
                  },
                  {
                    "dataId": 3862946,
                    "name": "Radio38",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862947,
                "name": "AttachButton32",
                "text": "<strong>Drug/Biologic/Food<strong>/Cosmetic</strong> Documentation</strong>",
                "description": "<em>Provide documentation for all study drugs/biologics/food/cosmetics, in particular:<br><ul><li><em>Risk documentation (e.g., Investigator Brochure (IB), package insert, etc.)</em></li><li><em>FDA Approval documentation (IND documentation, IND exemption determinations, etc.)</em></li><li><em>Formulation/Ingredient information (for foods, supplements, etc.)</em></li></ul></em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "attachment"
              }
            ]
          },
          {
            "dataId": 3862948,
            "name": "Group99",
            "text": "<strong>Devices</strong>",
            "description": "",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862910,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862949,
                "name": "TextArea81",
                "text": "<strong>Device Description</strong>",
                "description": "<em>Describe the Devices required/specified to be used in this project (See help Text). Include:<br><ul><li><em>Name of device / Common and/or Proprietary Name of the medical device.</em></li><li><em>Manufacturer. (If you are building or developing the device, indicate it here)</em></li><li><em>Purpose of intended use (Will you test Safety and/or Effectiveness?&nbsp;</em></li><li><em>For each device, if it is (1) Intended for use in the diagnosis, cure, mitigation, treatment, or prevention of disease; AND/OR (2) </em>Intended to affect the structure or any function of the body; BUT does not achieve its primary intended purposes through chemical action within or on the body, NOR is dependent upon being metabolized for the achievement of its primary intended purposes.</li></ul></em>",
                "required": false,
                "helpText": "<em><strong style=\"font-weight: bold;\"><em>Medical Device:</em></strong><em> An instrument, apparatus, implement, machine, contrivance, implant, in vitro reagent, or other similar or related article, including a component part, or accessory which is:<br></em><br>  <br><ul><li><em><em style=\"font-weight: bold;\">intended for use in the diagnosis, cure, mitigation, treatment, or prevention of disease or other conditions </em></em></li></ul><em style=\"font-weight: bold;\">&nbsp;(Examples: EEG, ECG, MRI,&nbsp;NIRS, TENS, Ultrasound, microneurography electrodes, low-level laser, pneumobelt, hearing aid, X-ray) or;&nbsp; &nbsp;&nbsp;<br></em><br>  <br><ul><li><em><em style=\"font-weight: bold;\">intended to affect the structure <u>or</u> any function of the body.  </em></em></li></ul><em style=\"font-weight: bold;\"> (Examples: pacemakers, implants, brain stimulation devices, prosthetics)<br></em><br>  <em style=\"font-weight: bold;\"><br></em><strong>Any devices used in this study, even those which do not meet the definition above, must be described in the protocol - including how they operate and how they will be utilized with subjects.</strong><br><br><br><strong></strong><br><strong>Testing Safety</strong></em><em>: A scientific evaluation to determine if the device?s probable benefits to health outweigh any probable risks, from use of the device for its intended uses and conditions of use and when accompanied by adequate directions and warnings against unsafe use. Studies evaluating the safety of a device shall adequately demonstrate the absence of unreasonable risk of illness or injury associated with the use of the device for its intended uses and conditions of use.  </em><a href=\"https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfCFR/CFRSearch.cfm?FR=860.7\" target=\"_blank\"><em>21 CFR 860.7(d)(1)</em></a><em><br> <br></em><em><br></em><br>  <strong><em>Testing Effectiveness:</em></strong><em> A scientific evaluation to determine whether a device is effective in providing clinically significant results in a significant portion of the target population, from use of the device for its intended uses and conditions of use and when accompanied by adequate directions for use and warnings against unsafe use.  </em><a href=\"https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfCFR/CFRSearch.cfm?FR=860.7\" target=\"_blank\"><em>21 CFR 860.7(e)(1)</em></a><em><br></em><br>",
                "label": "",
                "type": "textarea"
              },
              {
                "dataId": 3862950,
                "name": "Group100",
                "text": "<strong>Non-Significant Risk (NSR) Device</strong>",
                "description": "<em>Are you requesting a Non-Significant Risk determination for any Devices in this study?<br><br>This is applicable to Investigational Devices that  are subject to regulation under 21 CFR ?812, but do not have an IDE or are otherwise IDE Exempt. If the FDA has not already determined the device is Significant Risk, the IRB can evaluate risk to determine if a device is Non-Significant Risk (and so does not require an IDE).</em>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "children": [
                  {
                    "dataId": 3862951,
                    "name": "Radio90",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio",
                    "children": [
                      {
                        "dataId": 3862952,
                        "name": "TextArea83",
                        "text": "<strong>NSR Justification</strong>",
                        "description": "<em>Provide the risk assessment and justification for any devices for which you are requesting an NSR determination. Ensure any supporting risk documentation is uploaded in the Device Documentation area below.</em>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "textarea",
                        "dependencies": [
                          {
                            "targetId": 3862951,
                            "type": "displayed"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "dataId": 3862953,
                    "name": "Radio91",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862954,
                "name": "AttachButton33",
                "text": "<strong>Device Documentation</strong>",
                "description": "<em>Provide documentation for all study devices, in particular:<br><ul><li><em>Risk documentation </em></li><li><em>Device labeling/ Photo</em></li><li><em>Description/Instructions (e.g., Instructions for Use (IFU), Instruction Manuals, etc.)</em></li><li><em>FDA Approval documentation (IDE documentation, IDE exemption determinations, etc.)</em></li><li><em>Other relevant safety/device information for the IRB to consider during protocol review</em></li><li><em>FDA HUD Designation Approval letter</em></li></ul></em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "attachment"
              }
            ]
          }
        ]
      },
      {
        "dataId": 3862955,
        "name": "Section2",
        "text": "Multi-Site (Reviewing)",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862407,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3862956,
            "name": "Label22",
            "text": "You have indicated that one or more external institutions and/or external investigators will be engaged in human subjects research for this study.<br><br>Research may involve more than one institution and be within the responsibility of more than one Institutional Review Board (IRB). If this study involves research with a collaborating external institution(s) or investigator(s), check&nbsp; the help text&nbsp;first to see &nbsp;if TCU and the collaborating external institution(s)/investigator(s) are considered to be engaged in research. Institutions/investigators not engaged in research do not need IRB review for their research.<br>",
            "required": false,
            "helpText": "In general, an institution is considered engaged in a particular non-exempt human subjects research project when its employees or agents for the purposes of the research project obtain: <br>(1) data about the subjects of the research through intervention or interaction with them; <br>(2) identifiable private information about the subjects of the research; or <br>(3) the informed consent of human subjects for the research.<br>More specifically, an institution is engaged in research when ANY of the following apply:<br><br><ul><li>The institution is the awardee institution for a non-exempt human subjects research project, even if all activities will be carried out by employees or agents of another institution. </li><li>An employee or agent of the institution intervenes with human subjects for research purposes through </li><li>Invasive or noninvasive procedures (see examples below)</li><li>Manipulating the environment  (see examples below)</li><li>Interacting with any human subject of the research (see examples below)</li><li>Obtaining informed consent </li><li>Obtaining identifiable private information or identifiable specimens, even if there is no direct interaction with human subjects (see examples below)</li></ul><br>Examples of <em>invasive or noninvasive procedures</em> include:<br><ul><li>drawing blood; </li><li>collecting buccal mucosa cells using a cotton swab;</li><li>administering individual or group counseling or psychotherapy;</li><li>administering drugs or other treatments; </li><li>surgically implanting medical devices; </li><li>utilizing physical sensors; </li><li>utilizing other measurement procedures. </li></ul>Examples of <em>manipulating the environment </em>include:<br><ul><li>controlling environmental light, sound, or temperature;</li><li>presenting sensory stimuli; </li><li>orchestrating environmental events or social interactions.</li></ul>Examples of <em>interacting</em> include:<br><ul><li>engaging in protocol dictated communication or interpersonal contact; </li><li>asking someone to provide a specimen by voiding or spitting into a specimen container; </li><li>conducting research interviews or administering questionnaires. </li></ul>Obtaining <em>identifiable private information</em> or <em>identifiable specimens</em> includes, but is not limited to:<br><ul><li>observing or recording private behavior; </li><li>using, studying, or analyzing for research purposes identifiable private information or identifiable specimens provided by another institution; and </li><li>using, studying, or analyzing for research purposes identifiable private information or identifiable specimens already in the possession of the investigators&nbsp;</li></ul>",
            "label": "",
            "type": "label",
            "dependencies": [
              {
                "targetId": 3862407,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3862957,
            "name": "Group79",
            "text": "<strong>Collaborating Investigator(s) at External Institution(s)</strong>",
            "description": "If multiple institutions are engaged in the research, each institution's IRB may review the research independently, or you may request that only one IRB reviews the research for multiple institutions in what is called a Reliance Agreement or IRB Authorization Agreement (IAA). TCU may agree to one of the following arrangements:<br><br><ul><li>The TCU IRB&nbsp;<strong>relies</strong>&nbsp;on the other institution's IRB review of the research, or</li><li>The TCU IRB&nbsp;<strong>reviews</strong>&nbsp;the research for the other institution's IRB.</li></ul>In order to establish a reliance agreement, all institutions involved must agree to the reliance and each institution's internal requirements must also be met. The institution whose IRB reviews the research serves as the \"IRB of Record.\"<br><br>Before agreeing to review for one or more external institutions, TCU IRB must review your request and determine that the conditions for a reliance have been met.<br><br><strong>NOTE:</strong> Investigators at relying institutions may not begin conducting research until: <br><br><ul><li>The protocol has been approved by the TCU IRB, <strong>AND</strong></li><li>TCU and the relying IRB(s) have established a reliance agreement.</li></ul><br>If you wish to have the TCU IRB consider entering into a reliance agreement for this study:<br><br><ol><li>Review the&nbsp;<a href=\"https://research.tcu.edu/research-compliance/irb/reliance/\" target=\"_blank\">Office of Research Compliance Reliance page</a> &nbsp;for information on our reliance procedures.</li><li>Reach out to the external institution <strong>early in the application process</strong> to see if their IRB would be open to a reliance agreement with TCU.</li><li>Some institutions will not enter into a reliance agreement if the study qualifies for exemption from IRB review, you should reach out to the external institution early in the application process to find this out.</li><li>Determine what method of documenting the reliance is preferred. Typically this is done by contacting the external institution's study Principal Investigator or human subjects protections/IRB office.</li></ol>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862407,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3862958,
            "name": "Group71",
            "text": "<strong>Method of Initiating Reliance</strong>",
            "description": "In most cases, reliance agreements with non-TCU institutions are documented via the SMART IRB online reliance system. In some cases, an Institutional Authorization Agreement (IAA) may be utilized. The IAA must be signed by the institutional officials (IOs) at both institutions.&nbsp;<br><br>The Reviewing IRB will usually dictate how they would like the agreement documented. You should reach out to the external institution early in the application process to see if their IRB would be open to a reliance agreement with TCU, and to determine what method of documenting the reliance is preferred. Typically, this can be determined by contacting the external institution's study Principal Investigator or human subjects protections/IRB office.<br><br><strong>Please select the type of agreement requested.</strong><br>",
            "required": true,
            "helpText": "<strong>SMART IRB<br></strong><br><strong></strong>The Streamlined, Multisite, Accelerated Resources for Trials IRB Reliance platform, which is designed to harmonize and streamline the IRB review process for multisite studies, while ensuring a high level of protection for research participants. Smart IRB is not an IRB, but a master reliance agreement with many participating institutions, which are listed <a href=\"https://smartirb.org/participating-institutions/\" target=\"_blank\">here</a>.  The Smart IRB master reliance agreement replaces the need to have an individual Institutional Authorization Agreement (IAA).<br>Texas Christian University is a participating institution of Smart IRB and this method can be utilized to complete the reliance process for a study being conducted with another Smart IRB participating institution. The TCU IRB can rely on any non-TCU IRB that has also signed on with Smart IRB.<br><br>To review the<a href=\"https://research.tcu.edu/research-compliance/irb/reliance/\" target=\"_blank\"> TCU Smart IRB process</a>.&nbsp;<br><br><strong></strong><br><strong>IRB Authorization Agreement<br></strong><br>The most common agreement is an IRB Authorization Agreement (IAA). An IAA is usually specific to a single study, but are sometimes used by trial networks to cover their studies. Commonly, IAAs are also used for collaborators that are engaging in research on behalf of an institution that has its own IRB.<br>Typically, an IRB has its own short template IAA, and simply requires the signatures of each institution's signatory authority.&nbsp;<br><br><strong>Memorandums of Understanding<br></strong><br>Memorandums of Understanding (MOUs), also known as Master Agreements, specify a reliance arrangement between entities that can cover any research involving the stated entities, rather than being applicable to only one or a handful of specific studies. These agreements are used by large reliance networks, trial networks, and as individual agreements between TCU and other institutions with whom we commonly collaborate. <br><br>MOUs can require several months to develop and execute, as they require extensive legal and regulatory input from all involved institutions. For this reason, the establishment of an MOU is driven by the institutions instead of by individual investigators. <br><br><br>",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862407,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862959,
                "name": "Radio54",
                "text": "<a href=\"https://research.tcu.edu/research-compliance/irb/reliance/\" target=\"_blank\">Smart IRB (Preferred)</a>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3862960,
                    "name": "TextBox12",
                    "text": "Provide the Smart IRB application #",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textbox",
                    "dependencies": [
                      {
                        "targetId": 3862959,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862961,
                "name": "Radio55",
                "text": "IAA ( IRB Authorized Agreements)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3862962,
                "name": "Radio59",
                "text": "Other",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3862963,
                    "name": "TextBox6",
                    "text": "Please describe.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textbox",
                    "dependencies": [
                      {
                        "targetId": 3862962,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "dataId": 3862964,
            "name": "TextArea53",
            "text": "Please list the following for all participating sites&nbsp;that will conduct this study. Identify who will serve as participating site PI.<br><br><ul><li>Numerate each relying Institution's full name (No acronyms) & Federal Wide&nbsp;Assurance (FWA)# (see&nbsp;<a href=\"https://ohrp.cit.nih.gov/search/search.aspx?styp=bsc\" target=\"_blank\">Approved FWA Database</a>)</li><li>Name(s) and credentials of all investigators and their study team members. Identify who will serve as site PI and provide their email address.</li><li>Please attach the current Human Subject Research&nbsp;CITI training certificates for all sub-investigators and their teams.</li></ul>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "dependencies": [
              {
                "targetId": 3862407,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3862965,
            "name": "AttachButton19",
            "text": "Please attach CITI training for all study team members for each participating (relying) site.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "attachment"
          },
          {
            "dataId": 3862966,
            "name": "AttachButton30",
            "text": "Please attach any site-specific documents from the participating sites (i.e., consent documents, recruitment materials)",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "attachment"
          },
          {
            "dataId": 3862967,
            "name": "Group16",
            "text": "Please select the appropriate option.",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862968,
                "name": "Radio85",
                "text": "The protocol will be conducted the same at each participating site.",
                "required": false,
                "helpText": "",
