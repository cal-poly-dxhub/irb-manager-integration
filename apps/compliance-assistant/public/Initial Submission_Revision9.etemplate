                        "name": "CheckBox151",
                        "text": "Prolific",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862606,
                        "name": "CheckBox84",
                        "text": "Other",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox",
                        "children": [
                          {
                            "dataId": 3862607,
                            "name": "TextBox11",
                            "text": "Please decribe.",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "textbox",
                            "dependencies": [
                              {
                                "targetId": 3862606,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "dataId": 3862608,
        "name": "Section6",
        "text": "Participant Population & Recruitment",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862423,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3862609,
            "name": "Group7",
            "text": "<strong>Select the desired population(s) or Vulnerable Populations for this study.</strong>",
            "required": true,
            "helpText": "",
            "compoundType": "checkbox",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862610,
                "name": "CheckBox37",
                "text": "Adults (18-65)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862611,
                    "name": "Group22",
                    "text": "",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862610,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862612,
                        "name": "CheckBox138",
                        "text": "Healthy Adults",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862613,
                        "name": "CheckBox140",
                        "text": "Patients&nbsp;",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862614,
                        "name": "CheckBox10",
                        "text": "Students (I8 years of age and over)",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox",
                        "children": [
                          {
                            "dataId": 3862615,
                            "name": "Label6",
                            "text": "<em>If the study includes students and their participation in research&nbsp;is a course requirement, then the PI should consider accounting for students who are under the age of 18 and&nbsp;may be enrolled in the class. This would require&nbsp;a parental consent and assent form and an additional process for consent/assent as a part of the submission.</em>",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "label",
                            "dependencies": [
                              {
                                "targetId": 3862614,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "dataId": 3862616,
                        "name": "CheckBox15",
                        "text": "Employees",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862617,
                        "name": "CheckBox47",
                        "text": "Parents",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862618,
                        "name": "CheckBox139",
                        "text": "Caregivers&nbsp;",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862619,
                        "name": "CheckBox31",
                        "text": "Business Owners/ Entrepreneurs",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  },
                  {
                    "dataId": 3862620,
                    "name": "TextBox2",
                    "text": "If you have a specific age range please provide it here.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textbox",
                    "dependencies": [
                      {
                        "targetId": 3862614,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862616,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862617,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862621,
                "name": "CheckBox43",
                "text": "Adults (65>)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862622,
                "name": "CheckBox44",
                "text": "Children (Minors & wards).&nbsp;",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862623,
                    "name": "Group11",
                    "text": "<strong><em>Children</em>.</strong> Persons who have not attained the legal age for consent to treatments or procedures involved in human subject research, under the applicable law of the jurisdiction in which the research will be conducted (45 CFR 46. 402(a)).<br><br><strong><em>Ward</em>. </strong>A child who is placed in the legal custody of the State or other agency, institution, or entity, consistent with applicable Federal, State, or Local Law.<br><br><em><strong>Emancipated Minor.</strong></em>&nbsp;A legal status conferred upon persons who have not yet attained the age of legal competency as defined by Texas state law, but who are entitled to treatment as if they had by virtue of assuming adult responsibilities, such as self-support, marriage, or procreation.  Those who have had the disabilities of minority removed for limited or general purposes by the State of Texas.<br><br>",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862622,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862624,
                        "name": "CheckBox45",
                        "text": "0-6 yrs old",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862625,
                        "name": "CheckBox46",
                        "text": "7-17 yrs old",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  },
                  {
                    "dataId": 3862626,
                    "name": "Group83",
                    "text": "Are you including children with any special needs?&nbsp; (For example Autism Spectrum Disorder (ASD),&nbsp;Attention Deficit Hyperactivity Disorder (ADHD),&nbsp;Behavior Disorders, Down Syndrome.)",
                    "required": false,
                    "helpText": "",
                    "compoundType": "radio",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862622,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862627,
                        "name": "Radio114",
                        "text": "Yes",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio",
                        "children": [
                          {
                            "dataId": 3862628,
                            "name": "TextArea72",
                            "text": "What additional precautions to protect&nbsp;participants and study team members will be utilized?&nbsp;",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "textarea",
                            "dependencies": [
