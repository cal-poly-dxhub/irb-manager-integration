                      {
                        "dataId": 3862924,
                        "name": "CheckBox225",
                        "text": "<em>PreMarket (PMA) Approved&nbsp;</em><a href=\"https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfpma/pma.cfm#:~:text=Premarket%20approval%20(PMA)%20is%20the,of%20Class%20III%20medical%20devices.\" target=\"_blank\">Premarket approval</a><em>&nbsp;(PMA) is the FDA process of scientific and regulatory review to evaluate the safety and effectiveness of Class III medical devices</em>",
                        "required": false,
