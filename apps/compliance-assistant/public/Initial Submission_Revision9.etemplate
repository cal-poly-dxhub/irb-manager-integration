                        "text": "No",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862630,
                "name": "CheckBox48",
                "text": "Pregnant Women",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862631,
                "name": "CheckBox49",
                "text": "Prisoners",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862632,
                    "name": "TextArea71",
                    "text": "<strong>Subpart C Certification information</strong>",
                    "description": "<strong>Please provide the following information :<br></strong><ol><li>Award Number(s) <em>(If applicable)</em></li><li>Name of funding Agency</li><li>Granting Institution's Program Officer and their email address</li></ol>",
                    "required": false,
                    "helpText": "",
