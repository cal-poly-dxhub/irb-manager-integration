            "description": "<em>Check all that apply.</em>",
            "required": true,
            "helpText": "",
            "compoundType": "checkbox",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862762,
                "name": "CheckBox114",
                "text": "Normal Educational Practices",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862763,
                    "name": "Group65",
                    "text": "",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "children": [
                      {
                        "dataId": 3862764,
                        "name": "CheckBox133",
                        "text": "Please affirm research, conducted in established or commonly accepted educational settings, that specifically involves normal educational practices that are not likely to adversely impact students' opportunity to learn required educational content or the assessment of educators who provide instruction. This includes most research on regular and special education instructional strategies, and research on the effectiveness of or the comparison among instructional techniques, curricula, or classroom management methods.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox",
                        "dependencies": [
                          {
