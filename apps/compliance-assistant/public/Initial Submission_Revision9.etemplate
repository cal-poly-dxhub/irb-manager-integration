          },
          {
            "dataId": 3862874,
            "name": "TextBox34",
            "text": "<strong>Total Number of Charts to review</strong>",
            "description": "Please list the total number of charts you plan to review/enroll in your study through all study sites",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "textbox",
            "dependencies": [
              {
