            "children": [
              {
                "dataId": 3862554,
                "name": "AttachButton36",
                "text": "Please attach all recruitment material(s) (e.g. emails, flyers, advertisements, etc.)<em>Please reference the </em><a href=\"https://research.tcu.edu/wp-content/uploads/2020/09/Recruitment-Guidelines_celan.docx\" target=\"_blank\">TCU IRB Recruitment Guidelines</a><em> for required elements. TCU </em><a href=\"https://research.tcu.edu/wp-content/uploads/2018/11/TCU-Email-Template.docx\" target=\"_blank\">Email</a><em>, </em><a href=\"https://research.tcu.edu/wp-content/uploads/2018/11/TCU-Flier-Template.docx\" target=\"_blank\">flyer</a><em>, and </em><em><a href=\"https://research.tcu.edu/wp-content/uploads/2018/11/TCU-Recruitment-Template.docx\" target=\"_blank\">advertisement templates</a> are available on our</em><a href=\"https://research.tcu.edu/research-compliance/irb/irb-forms-templates/\" target=\"_blank\"> website</a><em>.</em>",
                "required": false,
                "helpText": "",
