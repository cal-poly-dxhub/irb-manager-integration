                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862870,
                "name": "AttachButton9",
                "text": "Flow diagrams, schedule of events, or study scheme may be attached here to clarify more complex projects",
                "description": "<em>Please see the</em>&nbsp;<a href=\"https://research.tcu.edu/wp-content/uploads/2024/07/Schedule-of-Evidents-Guidelines-Template_2024.docx\" target=\"_blank\">Schedule of Events Guidelines</a>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "attachment"
              }
            ]
          },
          {
            "dataId": 3862871,
            "name": "Group111",
            "text": "<strong>Date Range of Chart Review</strong>",
            "description": "Please indicate the date range for the charts that will be reviewed.",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "question",
            "dependencies": [
              {
