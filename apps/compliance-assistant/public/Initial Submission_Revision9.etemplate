          {
            "dataId": 3862362,
            "name": "Group20",
            "text": "<strong>Funding</strong>",
            "description": "The questions below refer to the source of the financial support (study funding); <strong>this includes self-funded support</strong>.<br><br>An example would be a study where the TCU Office of Sponsored Programs (OSP)&nbsp;is receiving funding from another institution (Baylor University) via a sub-award/contract, but that institution receives the funding directly from a federal funding source (NIH). The questions would be answered with the federal funding source (NIH) in mind.<br><br>If any external funding, federal or otherwise, is received at a non-TCU site (reviewing or relying), the questions would be answered with the non-TCU site and external funding source in mind.<br><br><br>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862363,
                "name": "Group3",
                "text": "Is your study funded?",
                "description": "<div><em><br></em></div>",
                "required": true,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "children": [
                  {
                    "dataId": 3862364,
                    "name": "Radio1",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  },
                  {
                    "dataId": 3862365,
                    "name": "Radio2",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
