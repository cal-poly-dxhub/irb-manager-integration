        "children": [
          {
            "dataId": 3862677,
            "name": "Group36",
            "text": "Please select <strong><em>ALL&nbsp;</em></strong>appropriate options for your study.",
            "description": "",
            "required": true,
            "helpText": "",
            "compoundType": "checkbox",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862678,
                "name": "CheckBox73",
                "text": "Providing information sheet (&nbsp;<a href=\"https://www.ecfr.gov/cgi-bin/retrieveECFR?gp=&SID=83cd09e1c0f5c6937cd9d7513160fc3f&pitd=20180719&n=pt45.1.46&r=PART&ty=HTML#se45.1.46_1104\" target=\"_blank\">exempt&nbsp;</a>studies only)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862679,
                "name": "CheckBox66",
                "text": "Obtaining written consent from Adults <em>(This includes obtaining an electronic&nbsp; signature by&nbsp;finger or&nbsp;stylus; this must be explained in the consent process below.)&nbsp;</em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862680,
                "name": "CheckBox69",
                "text": "Obtaining Parental Permission consent",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862681,
                "name": "CheckBox67",
                "text": "Obtaining assent from&nbsp;a minor under 18",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862682,
                "name": "CheckBox68",
                "text": "Obtaining consent from a LAR <em>(Legally Authorized Representative)</em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862683,
                "name": "CheckBox70",
                "text": "Obtaining consent online or E-consent <em>(Requires a waiver of consent documentation) (do not select if using research information sheet)</em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862684,
                "name": "CheckBox72",
                "text": "Obtaining consent virtually<em> (e.g., over the phone or via Zoom)</em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862685,
                "name": "CheckBox160",
                "text": "Conducting a chart review where consent waivers are required <em>(Retrospective Chart Reviews only)</em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862686,
                "name": "CheckBox11",
                "text": "Obtaining consent from non-English speakers",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862687,
                "name": "CheckBox12",
                "text": "Collecting PHI (Protected Health Information) where HIPAA applies (from a medical record)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 4275998,
                "name": "CheckBox256",
                "text": "Request a waivers",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              }
            ]
          },
          {
            "dataId": 3862688,
            "name": "TextArea76",
            "text": "<strong>Research Information Sheet Process</strong>",
            "description": "<em>Please provide a process for how information about the study will be communicated to potential participants. Indicate if information will provided in-person or by electronic means.&nbsp;</em>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "dependencies": [
              {
                "targetId": 3862678,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3862689,
            "name": "TextArea19",
            "text": "<strong>Informed Consent Process</strong>",
            "description": "<ol><li>Describe where and when the consent process will take place.</li><li>Describe the time that will be devoted to the consent discussion.</li><li>Describe the roles of the individuals listed in the application as being involved in the consent process (PI- Co-I's) </li><li>Describe any waiting period/ time for questions available between informing the prospective participant, the participant's LAR (Legally Authorized Representative), or the participant's parents about the study and obtaining consent/parental permission.</li><li>The process to ensure ongoing consent (<em>if there are multiple visits</em>).</li><li> Steps that will be taken to minimize the possibility of coercion or undue influence.</li><li> Steps that will be taken to ensure the participants' understanding.   </li></ol>          As applicable: <br>             <ol><li>If students are used as participants, indicate that an alternative to participation will be provided if course credit is provided for participation.</li><li>If a vulnerable population is recruited, describe the measures that will be taken to obtain a surrogate/LAR (Legally Authorized Representative) consent (e.g., cognitively impaired participants) or assent from minors and permission from parents of minors.&nbsp; &nbsp;</li></ol>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "dependencies": [
              {
                "targetId": 3862679,
                "type": "displayed"
              },
              {
                "targetId": 3862680,
                "type": "displayed"
              },
              {
                "targetId": 3862681,
                "type": "displayed"
              },
              {
                "targetId": 3862682,
                "type": "displayed"
              },
              {
                "targetId": 3862683,
                "type": "displayed"
              },
              {
                "targetId": 3862684,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3862690,
            "name": "AttachButton14",
            "text": "Please attach all consent and/or assent documents",
            "description": "All consent templates are available on the&nbsp;<a href=\"https://research.tcu.edu/research-compliance/irb/irb-forms-templates/\" target=\"_blank\">TCU Research Compliance website</a>.<br>Please refer to the TCU IRB informed consent policy, consenting instructions/definitions, and relevant templates on the IRB forms and templates page of our website.",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "attachment",
            "dependencies": [
              {
                "targetId": 3862679,
                "type": "displayed"
              },
              {
                "targetId": 3862680,
                "type": "displayed"
              },
              {
                "targetId": 3862681,
                "type": "displayed"
              },
              {
                "targetId": 3862682,
                "type": "displayed"
              },
              {
                "targetId": 3862683,
                "type": "displayed"
              },
              {
                "targetId": 3862684,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3862691,
            "name": "AttachButton42",
            "text": "Please attach research information sheet documents",
            "description": "Research information sheet templates are available on the <a href=\"https://research.tcu.edu/research-compliance/irb/irb-forms-templates/\" target=\"_blank\">TCU Research Compliance website</a>.<br>Please refer to the TCU IRB informed consent policy, consenting instructions/definitions, and relevant templates on the IRB forms and templates page of our website.",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "attachment",
            "dependencies": [
              {
                "targetId": 3862678,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3862692,
            "name": "TextArea70",
            "text": "<strong>Participant withdrawal procedures</strong>",
            "description": "<ol><li>Describe the procedures for withdrawing from the study.&nbsp;</li><li>Include if participant withdraws their consent will they also be able to request their data (information or samples)&nbsp;&nbsp;be withdrawn as well or will the study keep&nbsp;data for analysis or future research?</li></ol><strong>Note:</strong><em> <strong>Please make sure this process is explicitly clear in the informed consent document.</strong></em>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "dependencies": [
              {
                "targetId": 3862678,
                "type": "displayed"
              },
              {
                "targetId": 3862679,
                "type": "displayed"
              },
              {
                "targetId": 3862680,
                "type": "displayed"
              },
              {
                "targetId": 3862681,
                "type": "displayed"
              },
              {
                "targetId": 3862682,
                "type": "displayed"
              },
              {
                "targetId": 3862683,
                "type": "displayed"
              },
              {
                "targetId": 3862684,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3862693,
            "name": "Group63",
            "text": "<strong>Informed  Consent Waiver Request</strong>",
            "description": "Will you need a waiver or alteration of consent?",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862679,
                "type": "displayed"
              },
              {
                "targetId": 3862680,
                "type": "displayed"
              },
              {
                "targetId": 3862681,
                "type": "displayed"
              },
              {
                "targetId": 3862682,
                "type": "displayed"
              },
              {
                "targetId": 3862683,
                "type": "displayed"
              },
              {
                "targetId": 3862684,
                "type": "displayed"
              },
              {
                "targetId": 3862685,
                "type": "displayed"
              },
              {
                "targetId": 4275998,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862694,
                "name": "Radio39",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3862695,
                "name": "Radio40",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3862696,
            "name": "Group51",
            "text": "Please select the appropriate request&nbsp; for your research",
            "description": "<em><strong>Note: </strong>if not sure, select yes and read Help Text for reference</em>",
            "required": false,
            "helpText": "<strong>Waiver of Informed Consent</strong>: Consent will not be sought by the investigator for some or all participants enrolled. The waiver may apply to only part of the study or the entire study.<br><br><strong>Alteration</strong><strong> of Informed Consent :</strong><br>Some or all of the elements of informed consent normally required by the IRB are changed or omitted.<br><br><strong>Waiver of Documentation of Informed Consent:&nbsp;</strong><br><strong></strong><strong>&nbsp;</strong>Consent will be obtained, however, a consent document will not be signed.  This waiver may apply to only part of the study <em>(e.g., screening phase)</em> or the entire study.<br><br>",
            "compoundType": "checkbox",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862694,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862697,
                "name": "CheckBox76",
                "text": "Waiver of&nbsp; Informed Consent",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862698,
                    "name": "TextArea21",
                    "text": "<ol><li>Describe how the risk in this research is minimal.</li><li>Without the protection of informed consent, how are the rights and welfare of the participants protected (not adversely affected)&nbsp;</li><li>Explain why it is not practicable to carry out the research without the waiver or alteration.&nbsp;Design issues or feasibility issues; pick one and provide justification based on the selected option.</li><li>Explain why it is not practicable to carry out the research without using identifiable private information or biospecimens, if applicable. Design issues or feasibility issues; pick one and provide justification based on the selected option.</li><li> If it may be appropriate to provide participants with additional pertinent information after the study is done, explain what type of information you anticipate giving the subjects and how it would be handled.</li></ol>",
                    "description": "<strong>Note: </strong>You <strong>MUST</strong> address each point as applicable to your study.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3862697,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862699,
                "name": "CheckBox77",
                "text": "Alteration of Informed Consent",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862700,
                    "name": "TextArea25",
                    "text": "<ol><li>Describe how the risk in this research is minimal.</li><li>Without the protection of informed consent, how are the rights and welfare of the participants protected (not adversely affected)</li><li>Explain why it is not practicable to carry out the research without the waiver or alteration. Design issues or feasibility issues; pick one and provide justification based on the selected option.</li><li>Explain why it is not practicable to carry out the research without using identifiable private information or biospecimens, if applicable. Design issues or feasibility issues; pick one and provide justification based on the selected option.</li><li>If it may be appropriate to provide participants with additional pertinent information after the study is done, explain what type of information you anticipate giving the subjects and how it would be handled.</li></ol>",
                    "description": "<strong>Note: </strong>You <strong>MUST</strong> address each point as applicable to your study.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3862699,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862701,
                "name": "CheckBox78",
                "text": "Waiver of Documentation of Informed Consent",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862702,
                    "name": "Group52",
                    "text": "<br><strong>Select the most appropriate acceptable justification for waiver of documentation</strong>",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862701,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862703,
                        "name": "CheckBox79",
                        "text": "Justification<strong> A:&nbsp;</strong>Where both of the following statements must be true.<br><br><ol><li>The only record linking the subject and the research would be the consent document</li><li>The principal risk of the study would be potential harm resulting from a breach of confidentiality if a consent form were required.</li></ol>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862704,
                        "name": "CheckBox80",
                        "text": "Justification <strong>B:&nbsp;</strong>The research involves no procedures for which written consent is normally required outside of the research context.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862705,
                        "name": "CheckBox81",
                        "text": "Justification<strong> C:&nbsp;</strong>The participants or legally authorized representatives are members of a distinct cultural group or community in which signing forms is not the norm.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  },
                  {
                    "dataId": 3862706,
                    "name": "TextArea22",
                    "text": "<strong><br>Plan for providing information relevant to the research when documentation is waived<br></strong><br>  If it may be appropriate to provide participants with a written statement regarding the research before participation.  If so, provide a plan for providing subjects with information about the research.  Include a description of the type of information you anticipate providing the subjects (e.g., an information letter).",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3862701,
                        "type": "displayed"
                      }
                    ]
                  },
                  {
                    "dataId": 3862707,
                    "name": "Group53",
                    "text": "<strong><br>Plan for documenting that verbal consent was obtained. <em>(CHOOSE ONE)</em> </strong>",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862701,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862708,
                        "name": "CheckBox82",
                        "text": "The person obtaining consent will write a research note for each subject and place it in theparticipants' research record. <br><br><strong>An example of a research note for consent is: </strong><em><strong>On [DATE], the participant was provided information about the study including purpose, risks, benefits, procedures, etc; subject was provided an opportunity to ask questions and have them answered; and verbal consent was obtained/not obtained to participate in the study</strong></em>.<br><br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862709,
                        "name": "CheckBox83",
                        "text": "Other",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox",
                        "children": [
                          {
                            "dataId": 3862710,
                            "name": "TextArea23",
                            "text": "Please describe.",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "textarea",
                            "dependencies": [
                              {
                                "targetId": 3862709,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862711,
                "name": "CheckBox147",
                "text": "Waiver of Assent",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862712,
                    "name": "Group116",
                    "text": "Confirm all criteria for waiver of assent have been met.",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862711,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862713,
                        "name": "CheckBox248",
                        "text": "The child's capability to comprehend the research and provide assent is so limited that they cannot reasonably be consulted. This often applies to very young children or children with severe cognitive impairments.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862714,
                        "name": "CheckBox249",
                        "text": "The research holds out the prospect of direct benefit to the child's health or well-being, and the intervention or procedure is available only in the context of the research. This is often the case in therapeutic research where the intervention is considered beneficial, and no alternative treatments are available.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862715,
                        "name": "CheckBox250",
                        "text": "The research involves no more than minimal risk to the child and involves no procedures for which assent is required when conducted on adults.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862716,
                "name": "CheckBox251",
                "text": "Waiver of Parent Permission",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862717,
                    "name": "Group118",
                    "text": "Confirm all criteria for waiver of parental permission have been met.",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862716,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862718,
                        "name": "CheckBox252",
                        "text": "The research cannot be conducted without waiving parental permission. This often involves sensitive topics where parental involvement might hinder honest responses (e.g., substance use, sexual behavior).",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862719,
                        "name": "CheckBox253",
                        "text": "An appropriate mechanism is in place to protect the children (explained in the study procedures or risk section of the application.)",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862720,
                        "name": "CheckBox254",
                        "text": "The waiver is not inconsistent with federal, state, or local law (45 CFR 46.408(c)). The choice of an appropriate substitute mechanism (for example, appointing a child advocate or an assent monitor) for protecting children participating in research would depend on the nature and purpose of the activities described in the protocol, the risk and anticipated benefit to the research subjects, and the child's age, maturity, status, and condition (45 CFR 46.408(c)).",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "dataId": 3862721,
            "name": "TextArea24",
            "text": "If including Non-English-speaking participants, please include a plan to have consent documents or other study documents translated after initial approval, by either student or faculty that is fluent in the desired language (give names and document translation and back translation) or a translation service/vendor.",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "dependencies": [
              {
                "targetId": 3862686,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862722,
                "name": "AttachButton15",
                "text": "Please attach the completed&nbsp;<a href=\"https://research.tcu.edu/research-compliance/irb/irb-forms-templates/\" target=\"_blank\">translation certification form.</a>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "attachment"
              }
            ]
          },
          {
            "dataId": 3862723,
            "name": "Group56",
            "text": "<strong>HIPAA</strong>",
            "description": "Will you collect any PHI (Protected Health Information) prospectively from participants?",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862687,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862724,
                "name": "Radio33",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3862725,
                    "name": "Group57",
                    "text": "Please select which of the 18 identifiers you will collect as a part of this research where health information is associated with them.<br>",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862724,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862726,
                        "name": "CheckBox86",
                        "text": "Names",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862727,
                        "name": "CheckBox87",
                        "text": "Dates, except year",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862728,
                        "name": "CheckBox88",
                        "text": "Telephone Numbers",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862729,
                        "name": "CheckBox89",
                        "text": "Geographic Data",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862730,
                        "name": "CheckBox90",
                        "text": "FAX numbers",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862731,
                        "name": "CheckBox91",
                        "text": "Social Security Numbers",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862732,
                        "name": "CheckBox92",
                        "text": "Email Addresses",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862733,
                        "name": "CheckBox93",
                        "text": "Medical Record Numbers",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862734,
                        "name": "CheckBox94",
                        "text": "Account Numbers",
                        "required": false,
