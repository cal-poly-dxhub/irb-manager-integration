          {
            "dataId": 3863004,
            "name": "TextBox23",
            "text": "Reviewing institution's IRB Protocol #",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textbox"
          },
          {
            "dataId": 3863005,
            "name": "TextBox24",
            "text": "Reviewing site's Principal Investigator's name and email address.",
            "required": true,
