      },
      {
        "dataId": 3862586,
        "name": "Section7",
        "text": "Study Information",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862423,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3862587,
            "name": "TextArea4",
            "text": "<strong>Study Design</strong>",
            "description": "Please describe the study design and its objectives, aims, or hypotheses.&nbsp;<br><em>Describe the overall approach of the study. For example, if the study is prospective, interventional, retrospective, etc., or if your study includes more than one group, arm, or subject population, describe that here (e.g.,  a study with a prospective interventional arm and a retrospective chart review arm). <br><br>If this is a clinical trial, for example, include if this is a single-arm, placebo-controlled, blinded, etc. If the clinical&nbsp;&nbsp;trial study design involves a new treatment, include the phase of the clinical trial (</em><a href=\"https://www.fda.gov/patients/drug-development-process/step-3-clinical-research#Clinical_Research_Phase_Studies\" target=\"_blank\">Phase I, II, III, IV&nbsp;</a><em>)<br></em>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3862588,
            "name": "TextArea50",
            "text": "<strong>Outcomes</strong>",
            "description": "Describe the anticipated outcomes of the study.",
            "required": true,
            "helpText": "An outcome measure is the result of a treatment or intervention that is used to objectively determine the baseline function<br>of a patient at the beginning of the clinical trial. Once the treatment or intervention has commenced, the same instrument<br>can be used to determine progress and efficacy. Outcome measures normally stem from overarching goals and aims.<br>Outcome measures should be measurable, which indicates that they are assessed by a numerical value. <br>",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3862589,
            "name": "TextArea5",
            "text": "<strong>Background</strong>",
            "description": "Describe the theory or data supporting the study's objectives and include a bibliography of key references as applicable.<br><br><ul><li><em>Briefly discuss relevant background information and literature reviewed to provide the rationale for the proposed research.</em></li><li><em>Cite references in text, as appropriate, to justify the purpose and hypothesis[es].</em></li><li><em>State the relevance of this research to and potential for contribution to the field of research.</em></li></ul>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "children": [
              {
                "dataId": 3862590,
                "name": "AttachButton28",
                "text": "You may attach your references in a separate document",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "attachment"
              }
            ]
          },
          {
            "dataId": 3862591,
            "name": "Group10",
            "text": "<strong>Study Site Location</strong>",
            "description": "Please select All appropriate options for&nbsp;&nbsp;the location of the study",
            "required": true,
            "helpText": "",
            "compoundType": "checkbox",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862592,
                "name": "CheckBox39",
                "text": "Texas Christian University&nbsp; (on-campus)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862593,
                    "name": "TextBox15",
                    "text": "Please provide the exact location on-campus where study procedures will take place.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textbox",
                    "dependencies": [
                      {
                        "targetId": 3862592,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862594,
                "name": "CheckBox40",
                "text": "External Site (Non-TCU site) Requiring a<a href=\"https://research.tcu.edu/wp-content/uploads/2023/08/Letter-of-Support-Guidelines_7.2023.docx\" target=\"_blank\">&nbsp;Letter of Support</a><a href=\"https://research.tcu.edu/wp-content/uploads/2021/08/Letter-of-Support-Guidelines_8.2021.docx\" target=\"_blank\"></a>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862595,
                    "name": "TextBox16",
                    "text": "Please provide the exact location(s) off-campus where study procedures will take place.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textbox",
                    "dependencies": [
                      {
                        "targetId": 3862594,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862596,
                        "name": "Label13",
                        "text": "When research is being conducted at an outside institution or organization of any kind, or when the investigator is otherwise relying on the cooperation of another institution, a letter from that institution acknowledging and supporting that relationship is required. A letter of support may also be required when an investigator conducts research in a department other than their own. The organization's administration should be contacted to determine who is authorized to provide permission. When accessing sites within a larger organization, permission may be required from more than one level of authority.<br><br><br>Please see TCU Office of Research Compliance <a href=\"https://research.tcu.edu/wp-content/uploads/2021/08/Letter-of-Support-Guidelines_8.2021.docx\" target=\"_blank\">Letter of Support Guideline</a>s for the required criteria and attach them for review.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "label",
                        "children": [
                          {
                            "dataId": 3862597,
                            "name": "AttachButton7",
                            "text": "Please attach your letter of support here.",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "attachment"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862598,
                "name": "CheckBox129",
                "text": "External Site not requiring a letter of support (Public meeting space)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862599,
                "name": "CheckBox41",
                "text": "International Site",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862600,
                "name": "CheckBox33",
                "text": "Online",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862601,
                    "name": "Group13",
                    "text": "Select all that apply.",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862600,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862602,
                        "name": "CheckBox34",
                        "text": "Zoom",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862603,
                        "name": "CheckBox42",
                        "text": "Qualtrics: Please review the&nbsp;<a href=\"https://research.tcu.edu/wp-content/uploads/2023/08/Guidelines-Qualtrics_7.2023_Final_Clean.docx\" target=\"_blank\">Qualtrics Guidelines Document</a>",
                        "required": false,
