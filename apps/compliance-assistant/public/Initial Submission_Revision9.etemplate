                "name": "CheckBox50",
                "text": "Cognitively Impaired Adult Pariticipants",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862634,
                    "name": "Group80",
                    "text": "Will LARs (Legally Authorized Representatives)&nbsp; be used to obtain consent for these indidvulas?&nbsp;",
                    "required": false,
                    "helpText": "",
                    "compoundType": "radio",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862633,
