          {
            "dataId": 3862397,
            "name": "Group25",
            "text": "Is this a student-initiated study?<br>",
            "description": "<em>Does the study represent student-initiated human subjects research, i.e., a study that is both initiated and designed (including with faculty advisor/sponsor input) by the student Co-I?</em>",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862398,
