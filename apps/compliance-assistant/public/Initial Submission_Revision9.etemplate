          {
            "dataId": 3862745,
            "name": "Group59",
            "text": "Will you need to request a HIPAA waiver/alteration for research use of PHI?",
            "description": "<em><strong>Note: </strong>if not sure, select Yes and read Help Text for reference.</em>",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862724,
                "type": "displayed"
              },
              {
                "targetId": 3862685,
                "type": "displayed"
              },
              {
                "targetId": 3862687,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862746,
                "name": "Radio35",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3862747,
                    "name": "Group60",
                    "text": "Please select the appropriate request for your research. Definitions in the help text.",
                    "required": false,
                    "helpText": "<strong>Waiver of Authorization:&nbsp;</strong><br>The authorization&nbsp;will not be sought for some or all subjects.  The researchers plan to use/access identifiable health information (PHI) in order to obtain and record data without ever receiving subjects? written permission (e.g., chart reviews or verbal consent<strong>)</strong><br><strong></strong><br><strong>Partial Waiver of Authorization:</strong><br>Used to identify eligible subjects for recruitment in this research.  Continued access to PHI will be limited to those who later volunteer for the study and provide written authorization.<br><br><strong>Alteration of Authorization:</strong><br>Some or all of the elements of authorization are changed or omitted.",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862746,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862748,
                        "name": "CheckBox105",
                        "text": "Waiver of Authorization",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862749,
                        "name": "CheckBox106",
                        "text": "Partial Waiver of Authorization",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862750,
                        "name": "CheckBox107",
                        "text": "Alteration of Authorization",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  },
                  {
                    "dataId": 3862751,
                    "name": "Group61",
                    "text": "<br>Explain why it is <strong>not practicable</strong> to carry out the research without this waiver.",
                    "description": "Select all that apply.",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862746,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862752,
                        "name": "CheckBox108",
                        "text": "<strong>Identify/recruit ? </strong>access to records is needed to identify eligible subjects (e.g., chart reviews, partial waiver for recruitment, etc.)",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862753,
                        "name": "CheckBox109",
                        "text": "<strong>Limited Means/Resources? </strong>resources needed to identify and contact eligible subjects for recruitment are limited",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862754,
                        "name": "CheckBox110",
                        "text": "<strong>Large number of subjects projected ? </strong>potential subject population includes a large number of records to review and it is not feasible to attempt contact with all subjects",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862755,
                        "name": "CheckBox111",
                        "text": "<strong>Outdated records ? </strong>This is a retrospective study involving subjects who may have moved or expired and researchers cannot feasibly attempt to contact required sample",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862756,
                        "name": "CheckBox112",
                        "text": "<strong>Risk of breach of confidentiality ? </strong>The only record linking the subject and the research would be the signed authorization and a breach of confidentiality is the principal risk in this study (e.g., verbal consent)",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862757,
                        "name": "CheckBox113",
                        "text": "<strong>Other</strong>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox",
                        "children": [
                          {
                            "dataId": 3862758,
                            "name": "TextArea26",
                            "text": "",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "textarea",
                            "dependencies": [
                              {
                                "targetId": 3862757,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862759,
                "name": "Radio36",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          }
        ]
      },
      {
        "dataId": 3862760,
