            "label": "",
            "type": "textbox"
          },
          {
            "dataId": 3863006,
            "name": "TextArea46",
            "text": "Please provide Reviewing sites' IRB/HRPP contact name, title, and email address",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863007,
            "name": "AttachButton24",
            "text": "Reviewing sites IRB approval",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "attachment"
          },
          {
            "dataId": 3863008,
            "name": "AttachButton25",
            "text": "Please upload&nbsp; Approved Protocol, consent, measures/instruments, etc., from the Reviewing IRB.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "attachment"
          },
          {
            "dataId": 3863009,
            "name": "AttachButton29",
            "text": "Please upload local site-specific documents (i.e., consent, recruitment materials)",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "attachment"
          },
          {
            "dataId": 3863010,
            "name": "Group88",
            "text": "Please select the appropriate option.",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863011,
                "name": "Radio99",
                "text": "The protocol will be conducted at TCU the same as described in the protocol",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3863012,
                "name": "Radio100",
                "text": "The protocol will NOT be conducted the same at&nbsp; TCU as described in the protocol.&nbsp;",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3863013,
                    "name": "Group89",
                    "text": "Select all study activities that will be conducted at TCU.",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3863012,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3863014,
                        "name": "CheckBox116",
                        "text": "Research design",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3863015,
                        "name": "CheckBox117",
                        "text": "Recruitment",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3863016,
                        "name": "CheckBox119",
                        "text": "Obtaining consent",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3863017,
                        "name": "CheckBox120",
                        "text": "Administering&nbsp; study interventions",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3863018,
                        "name": "CheckBox123",
                        "text": "Collecting study data",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3863019,
                        "name": "CheckBox125",
                        "text": "Analyzing data",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3863020,
                        "name": "CheckBox126",
                        "text": "Other",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  },
                  {
                    "dataId": 3863021,
                    "name": "TextArea59",
                    "text": "Provide a more detailed description of the selected study activities.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3863012,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "dataId": 3863022,
        "name": "Section18",
        "text": "Collaborative Research",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862411,
            "type": "displayed"
          },
          {
            "targetId": 3869443,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3863023,
            "name": "Label5",
            "text": "A &nbsp;<strong>collaborative</strong>&nbsp;project involves two or more U.S. research sites, each conducting a different part of a research protocol under the direction/control of the lead PI. An example would be a non-exempt study in which TCU is the lead site and conducts the interaction/intervention with the human participants, but the analysis of the data is being done by an external institution/collaborator.",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "label"
          },
          {
            "dataId": 3863024,
            "name": "TextArea18",
            "text": "Describe who will conduct the data analysis and provide the name of their institution.&nbsp;<br><br><strong><em>You do not need to name members of the TCU study team; only those who are not affiliated with TCU who will conduct data analysis.&nbsp;</em></strong>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863025,
            "name": "TextArea54",
            "text": "Specify what collected data will be sent for analysis.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863026,
            "name": "Group45",
            "text": "Select the appropriate option.",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863027,
                "name": "Radio31",
                "text": "Data will contain identifiers.&nbsp;",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3863028,
                "name": "Radio32",
                "text": "Data will not contain identifiers. (de-identified)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3863029,
            "name": "AttachButton17",
            "text": "Attach external collaborators CITI training.",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "attachment",
            "dependencies": [
              {
                "targetId": 3863027,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3863030,
            "name": "TextArea55",
            "text": "How will the data be shared with the external collaborator(s) and how will it be stored?",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863031,
            "name": "TextArea69",
            "text": "Describe what will happen to the data once the analysis is complete.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          }
        ]
      },
      {
        "dataId": 3863032,
        "name": "Section17",
        "text": "International Research",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862599,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3863033,
            "name": "Label21",
            "text": "<strong>International Regulatory Requirements</strong><br>Research conducted outside of the US, or in collaboration with institutions not located in the US, may be subject to additional human subjects research regulations with which the study investigators must comply. To assist investigators in determining the appropriate regulations that apply, the Office of Research Compliance provides information in the <a href=\"https://research.tcu.edu/wp-content/uploads/2021/05/International-Research-Guidelines_5.2021.docx\" target=\"_blank\">International Research Guidelines</a>.&nbsp;<br>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "label"
          },
          {
            "dataId": 3863034,
            "name": "TextBox25",
            "text": "Please state where this research will be conducted. Cities, regions countries where research will be conducted.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textbox"
          },
          {
            "dataId": 3863035,
            "name": "TextArea68",
            "text": "For International research please provide an understanding of the local context by describing any political, legal, and cultural considerations specific to this study location.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863036,
            "name": "TextArea66",
            "text": "Describe the scientific/ethical justification for conducting the research in an international setting.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863037,
            "name": "TextArea67",
            "text": "Describe the societal and cultural beliefs in the country that may impact research conduct or alter the risks or benefits to subjects",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863038,
            "name": "Group90",
            "text": "Are there any aspects of the cultural, political, or economic climate in the country where the research will be conducted that might increase the risks for participation?",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863039,
                "name": "Radio101",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3863040,
                    "name": "TextArea60",
                    "text": "Please describe these risks and the steps you will take to minimize these risks.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3863039,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3863041,
                "name": "Radio102",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3863042,
            "name": "Group91",
            "text": "Was the researcher invited into the community?<br>",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863043,
                "name": "Radio103",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3863044,
                "name": "Radio104",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3863045,
            "name": "TextArea61",
            "text": "Describe how the researcher will have culturally appropriate access to the community.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "dependencies": [
              {
                "targetId": 3863043,
                "type": "displayed"
              },
              {
                "targetId": 3863044,
                "type": "displayed"
              }
            ]
          },
          {
            "dataId": 3863046,
            "name": "Group92",
            "text": "Is there an ethics committee or other IRB equivalent that requires the review of research in the country where research is being conducted?",
            "description": "<strong>Note:</strong> OHRP compiles a list of international human research standards that can be viewed <a href=\"https://www.hhs.gov/ohrp/international/compilation-human-research-standards/index.html\" target=\"_blank\">here</a>.<br><br>",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863047,
                "name": "Radio105",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3863048,
                    "name": "AttachButton26",
                    "text": "Attach documentation of approval.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "attachment",
                    "dependencies": [
                      {
                        "targetId": 3863047,
                        "type": "displayed"
                      }
                    ]
                  },
                  {
                    "dataId": 3863049,
                    "name": "TextArea62",
                    "text": "Provide contact information for the local IRB or Ethics Committee equivalent.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3863047,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3863050,
                "name": "Radio106",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3863051,
            "name": "Group93",
            "text": "When research is being conducted at an international site, institution, or organization of any kind, or when the investigator is otherwise relying on the cooperation of another institution, a letter from that institution acknowledging and supporting that relationship is required. A letter of support may also be required when an investigator conducts research in a department other than their own. The organization's administration should be contacted to determine who is authorized to provide permission. When accessing sites within a larger organization, permission may be required from more than one level of authority.<br><br><br>Please see the TCU Office of Research Compliance <a href=\"https://research.tcu.edu/wp-content/uploads/2021/08/Letter-of-Support-Guidelines_8.2021.docx\" target=\"_blank\">Letter of Support Guideline</a>s for the required criteria and attach them for review.",
            "description": "Will an&nbsp;institution, or organization of any kind be involved&nbsp; with this research?",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863052,
                "name": "Radio107",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3863053,
                    "name": "TextArea65",
                    "text": "Please describe.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3863052,
                        "type": "displayed"
                      }
                    ]
                  },
                  {
                    "dataId": 3863054,
                    "name": "AttachButton27",
                    "text": "Attach letter of support here.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "attachment",
                    "dependencies": [
                      {
                        "targetId": 3863052,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3863055,
                "name": "Radio108",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3863056,
            "name": "TextArea63",
            "text": "Describe how the researchers collecting data internationally will communicate with the TCU IRB in the event the project requires changes or there are reportable incidents.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863057,
            "name": "TextArea64",
            "text": "Identify a local contact who is fluent in the local language and provide their contact information:",
            "description": "<strong>This information is to also be placed in the informed consent document(s)</strong>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          }
        ]
      },
      {
        "dataId": 3863058,
        "name": "Section13",
        "text": "Cost & Compensation",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862423,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3863059,
            "name": "Group21",
            "text": "<strong>Cost</strong>",
            "description": "Will research participants incur any out-of-pocket cost they will be responsible for at any time during their participation in this study?",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863060,
                "name": "Radio13",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3863061,
                    "name": "TextArea8",
                    "text": "Please describe all costs to participants&nbsp;associated with the study.",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3863060,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3863062,
                "name": "Radio26",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3863063,
            "name": "Group34",
            "text": "<strong>Compensation</strong>",
            "description": "Will participants be compensated for their time and effort participating in this study?&nbsp;(gift cards, course credit, extra credit, SONA credit, etc.)",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863064,
                "name": "Radio27",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3863065,
                    "name": "TextArea9",
                    "text": "Describe in detail if participants will be compensated for their time and effort to complete the study procedures. Compensation can take on many forms and can include monetary (cash, gift cards, etc.) and/or non-monetary (gifts, course credit, extra credit, SONA credit, etc.) payments to subjects.&nbsp;<br><strong> For non-monetary items, please provide an approximate value.</strong><u style=\"font-weight: bold;\"><br></u><br><strong>Note:&nbsp;&nbsp;<strong>Compensation cannot be random, if utilizing a raffle, you must describe how you will choose which participants (every 5<sup>th</sup> or 10<sup>th</sup>, or 15<sup>th</sup> for example). Your consent document should clearly specify what form(s) and how compensation would be provided to participants in your study and the amount of payment. You must also include and describe if participants can still receive full or partial compensation should they either withdraw or are not able to complete the study procedures for any reason.</strong></strong><br>",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3863064,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3863066,
                "name": "Radio28",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          }
        ]
      },
      {
        "dataId": 3863067,
        "name": "Section12",
        "text": "Risk & Benefits",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862423,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3863068,
            "name": "TextArea13",
            "text": "<strong>Potential Risks and Mechanisms to Reduce Risk</strong>",
            "description": "<ol><li>List and Include (as may be useful for the IRB's consideration) a description of the probability, magnitude, duration, and reversibility of the risks. Consider physical, psychological, social, legal, and economic risks as well as risks to privacy and/or confidentiality.</li><li>Also, describe what measures have been or will be taken to prevent and minimize each of the risks identified. </li><li><strong><span style=\"font-weight: normal;\">Explain how this risk will be minimized during the experiment/intervention and after the experiment/intervention is complete (i.e., a full debriefing is attached in the previous study procedure&nbsp;section).</span></strong></li><li><em>(As Applicable)</em>&nbsp;If any deception is to be used, explain if the use of deception is likely to cause the participant psychological discomfort (i.e., stress, loss of self-esteem, embarrassment) while the deception is taking place.</li></ol>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863069,
            "name": "TextArea14",
            "text": "<strong>Potential Benefits</strong>",
            "description": "<ol><li>Describe the potential benefits of the research to the participants, to others with similar problems, and to society <strong>(Compensation is not a benefit to participation)</strong>.</li><li>&nbsp;<em>(As Applicable)</em>If using deception, describe how the potential benefits of the research justify the use of deception.</li></ol>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          }
        ]
      },
      {
        "dataId": 3863070,
        "name": "Section14",
        "text": "Privacy, Confidentiality, Data Analysis, & Data Monitoring",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862423,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3863071,
            "name": "TextArea15",
            "text": "<strong>Data Management&nbsp;&&nbsp;</strong><strong>Privacy/Confidentiality</strong>",
            "description": "<ol><li>Describe how the participant's privacy will be maintained during interventions or data collection.&nbsp;</li><li> Describe data protection/security plans during all phases of the research. Specify formats (e.g., hardcopy, electronic file, etc.), the location [PI office, computer (stand-alone or networked), secure server, mobile device (e.g., flash drive, external hard drive, tablet, etc.), cloud (specify service/vendor), etc.], and additional protections (password protection, encryption, anonymizing techniques, restricted access, confidentiality agreements, etc.) <em><strong>*Please note the TCU IRB does not suggest using personal devices for data storage. If personal devices must be used, collected data should be transferred to the TCU&nbsp;Box immediately after each data collection interaction.</strong></em></li><li>Provide the length of time the data and/or samples will be kept and how data will be ultimately destroyed.</li><li>Describe whether data and/or samples will be kept confidential (i.e., data/samples can be potentially linked to participants, such as through a code key) or anonymous (i.e., impossible to link data/samples to participants)</li><li>If data/samples will be destroyed, describe when and how destruction will occur.</li><li>Describe recordkeeping and record retention plans. Specify the format (e.g., hardcopy, electronic file, password protection, encryption, etc.) and the location of PI's office, computer (stand-alone or networked), secure cloud&nbsp;server (specify service/vendor), etc.].</li></ol>Note:&nbsp;&nbsp;<strong>All signed consents and hard data must be stored for a minimum of 3 years in a locked filing cabinet (and locked room) in the principal investigator's office, lab, or storage closet at TCU. </strong><strong>Your professional society may recommend keeping the materials for a longer period of time. <u><br></u></strong><br>",
            "required": true,
            "helpText": "<strong>Privacy </strong><br>Privacy refers to a person's desire to control the access of others to themselves. For example, persons may not want to be seen entering a place that might stigmatize them, such as a pregnancy counseling center that is clearly identified as such by signs on the front of the building. Privacy concerns people, whereas confidentiality concerns data. The research proposal should outline strategies to protect privacy including how the investigator will access information from or about participants.<br><br> In developing strategies for the protection of subjects' privacy, consideration should be given to:<br><br><ul><li>The methods used to identify and contact potential participants.&nbsp;</li><li> The settings in which an individual will be interacting with an investigator. </li><li>The appropriateness of all personnel present for research activities. </li><li>The methods used to obtain information about participants.</li><li>The nature of the requested information.</li><li>Information that is obtained about individuals other than the target participants and whether such individuals meet the regulatory definition of human participant (e.g., a subject provides information about a family member for a survey). </li><li>Privacy guidelines developed by relevant professional associations and scholarly disciplines (e.g., oral history, anthropology, psychology). How to access the minimum amount of information necessary to complete the study.</li></ul><br><strong> Regulatory and Guidance </strong><strong>References </strong><br>45 CFR 46.111(a)(7) <br>21 CFR 56.111(a)(7) <br><br><strong>Confidentiality </strong><br>Confidentiality refers to the researcher's agreement with the participant about how the participant's identifiable private information will be handled, managed, and disseminated. The research proposal should outline strategies to maintain confidentiality of identifiable data, including controls on storage, handling, and sharing of data. When appropriate, certificates of confidentiality could be used to maintain the confidentiality of identifiable data (for more information on Certificates of Confidentiality, see ORI's Certificate of Confidentiality Summary Sheet in the online IRB Survival Handbook under topic Confidentiality/Certificate of Confidentiality:). <br><br>When the IRB evaluates research proposals for strategies for maintaining confidentiality, where appropriate, consideration will be given as to whether: <br><br><ul><li>Methods to shield participants' identity adequately protect participant privacy. </li><li>There is a long-range plan for protecting the confidentiality of research data, including a schedule for destruction of identifiers associated with the data.</li><li>&nbsp;The consent form and other information presented to potential research participants adequately and clearly describe confidentiality risks. </li><li>The informed consent process and the informed consent document (and, if applicable, the HIPAA Authorization section), clearly delineate who will have access to the subject's information and under what circumstances data may be shared (i.e., with government agencies, sponsors).</li></ul>",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863072,
            "name": "Group77",
            "text": "<strong>Certificate of Confidentiality</strong>",
            "description": "Will or have you obtained a COC (Certificate of Confidentiality)? (See Help text)",
            "required": true,
            "helpText": "Certificates of Confidentiality (CoCs) <strong>protect the privacy of research subjects by prohibiting disclosure of identifiable, sensitive research information</strong> to anyone not connected to the research, except when the subject consents to allow disclosure or in a few other specific situations.<br><br>For how to obtain a COC please visit the&nbsp;<a href=\"https://grants.nih.gov/policy/humansubjects/coc/how-to-apply.htm\" target=\"_blank\">How to Get a Certificate of Confidentiality site</a>.<br><br>The following is an illustrative but not exhaustive list of research areas eligible for a Certificate:<ul><li>Research on HIV, AIDS, and other STDs;</li><li>Studies that collect information on sexual attitudes, preferences, or practices;</li><li>Studies on the use of alcohol, drugs, or other addictive products;</li><li>Studies that collect information on illegal conduct;</li><li>Studies that gather information that if released could be damaging to a participant's financial standing, employability, or reputation within the community;</li><li>Research involving information that might lead to social stigmatization or discrimination if it were disclosed;</li><li>Research on participants' psychological well being or mental health;</li><li>Genetic studies, including those that collect and store biological samples for future use;</li><li>Research on behavioral interventions and epidemiologic studies.</li></ul>Ineligible studies include projects that are<br><ul><li>not research based,</li><li>not approved by an IRB in accordance with these guidelines,</li><li>not collecting sensitive information or information that might harm the research participants, or</li><li>not collecting personally identifiable information.</li></ul>",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863073,
                "name": "Radio67",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3863074,
                "name": "Radio68",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3863075,
            "name": "TextArea16",
            "text": "<strong>Data Analysis</strong>",
            "description": "<ol><li>Describe how you will analyze your data to answer the study question.</li><li>Describe any procedures that will be used to ensure the accuracy and quality of collected data.</li><li>If participants withdraw from the study, describe their options regarding their data being used or removed from the study. </li><li>If transcribing data is needed, please indicate and provide the name of the person or service/vendor that will conduct the transcription with or without identifiers. </li></ol>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863076,
            "name": "TextArea30",
            "text": "<strong>Data Safety Monitoring</strong>",
            "description": "<ol><li>Monitoring is an ongoing review of the study throughout its duration. Please provide a plan to review data to ensure its integrity during data collection. Provide the frequency that data will be reviewed.</li><li>  Any action resulting in a temporary or permanent suspension of the study should be reported to the IRB and to the Office of&nbsp;Research Compliance.</li></ol><br><em><strong>&nbsp;Note: </strong>The PI is responsible for reporting any reasons outside the planned study design such as in compliance with the protocol or if there is any delay in the initiation of the study due to administrative reasons. This section <strong>must</strong><strong> be answered for clinical studies or greater than minimal risk studies.</strong></em>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "textarea"
          },
          {
            "dataId": 3863077,
            "name": "Group67",
            "text": "<strong>Data and/or Specimen Storage for Future Research</strong>",
            "description": "Will data or specimens be banked for future use by the research team that collected them or shared with other researchers?",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3863078,
                "name": "Radio51",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3863079,
                    "name": "TextArea38",
                    "text": "<ol><li>Describe where the data or specimens will be stored and how long they will be stored.</li><li>How will the data or specimens be labeled?</li><li>Who will have access to the data or specimens?</li><li>Will data or specimens be shared with other investigators?</li></ol>",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3863078,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3863080,
                "name": "Radio56",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          }
        ]
      }
    ],
