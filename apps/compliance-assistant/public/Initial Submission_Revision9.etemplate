                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862765,
                "name": "CheckBox134",
                "text": "Educational Test (cognitive, diagnostic, aptitude,achievement)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862766,
                    "name": "Group74",
                    "text": "Select all that apply.&nbsp;",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862765,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862767,
                        "name": "CheckBox135",
                        "text": "The identity of the participants cannot readily be ascertained, directly or through identifiers.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862768,
                        "name": "CheckBox136",
                        "text": "Any disclosure of the human subjects' responses outside the research would not reasonably place the subjects at risk of criminal or civil liability or be damaging to the subjects' financial standing, employability, educational advancement, or reputation.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862769,
                        "name": "CheckBox137",
                        "text": "The identity of the participants can readily be ascertained, directly or through identifiers.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862770,
                "name": "CheckBox61",
                "text": "Behavior decision-making test (puzzles, games)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862771,
                "name": "CheckBox62",
                "text": "Physical activities",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862772,
                "name": "CheckBox215",
                "text": "Deception/ Incomplete Disclosure & Debriefing",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862773,
                "name": "CheckBox216",
                "text": "Debriefing (without Deception)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862774,
                "name": "CheckBox175",
                "text": "Chart Review&nbsp;",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862775,
                    "name": "Label15",
                    "text": "<strong>Criteria to meet retrospective status (Exempt/Expedited) for review</strong>:<br><br><ul><li>The protocol must be research involving materials (data, documents, records, or specimens) that have already been collected solely for non-research purposes (such as medical treatment or diagnosis).</li></ul><ul><li>The protocol must include specific dates/information etc. that will be used.</li></ul><ul><li>All data must be in existence at the time of IRB submission.</li></ul><br><em>* </em><em><strong>Note: If all data are recorded in a de-identified manner, then the study would be exempt. However, if a link to other sources needs to be recorded with the data, then the study would be expedited and a waiver of consent and HIPAA would be required.</strong></em><br><br><strong>Criteria to meet prospective status (only Expedited) for review:</strong><br><br><ul><li>The protocol must be research involving data that does not yet exist at the time of IRB submission</li></ul><br><ul><li>For Prospective studies to meet the criteria for a Waiver of Consent, \"not practicable\" doesn't mean \"inconvenient\". If a study is planning on collecting data or specimens that are already being collected during clinical care for an ongoing prospective period, consider the following 2 scenarios</li></ul><br><ul><li>A- The study involves a large number of patients, seen at multiple locations, with multiple diagnoses.......consent is likely not practicable.</li></ul><br><ul><li>B- The study involves a single specialty clinic on a smaller set of patients who are regularly seen on a routine basis......consent could be seen as practicable. This scenario, however, would likely meet the criteria for a Waiver of Documentation of Consent, but it is feasible that the patients and families could consent.</li></ul>",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "label",
                    "dependencies": [
                      {
                        "targetId": 3862774,
                        "type": "displayed"
                      }
                    ]
                  },
                  {
                    "dataId": 3862776,
                    "name": "Group4",
                    "text": "Select the appropriate type of Chart Review&nbsp;",
                    "required": false,
                    "helpText": "",
                    "compoundType": "radio",
                    "label": "",
                    "type": "question",
                    "dependencies": [
