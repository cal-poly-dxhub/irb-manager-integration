                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3862400,
            "name": "Group12",
            "text": "Are you conducting Human Subject Research under an IRB-approved protocol at/by an external institution?",
            "required": false,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862398,
                "type": "displayed"
              },
              {
                "targetId": 3862398,
                "type": "required"
              },
              {
                "targetId": 3862399,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862401,
                "name": "Radio61",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3862402,
                "name": "Radio62",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3862403,
            "name": "Group5",
            "text": "Will this submission be a Multi-site study?",
            "description": "NIH uses the term \"<strong>multi-site</strong> project\" to describe a sub-set of cooperative non-exempt human research where the same research procedures (i.e., the <a href=\"https://research-compliance.umich.edu/node/5396\" target=\"_blank\">same protocol</a>) are conducted at two or more U.S. research sites under the control of a participating investigator at each site. <br>A multi-site project typically involves a lead site (lead PI) that manages the administrative functions of the project in addition to conducting the same research procedures as the participating sites. A multi-site project could be a clinical trial, an observational study, or a basic research study.&nbsp; <br><br><strong style=\"font-style: italic;\">Note:</strong><br><ul><li><em>If there are more than two U.S. research sites that will not be conducting the study exactly the same you will be asked to specify what research&nbsp;activities will take place at each institution.&nbsp;&nbsp;</em></li><li><em>If you are only working with collaborator(s) to analyze data after the study is complete at TCU please answer this question \"No\" and then select \"Yes\" for&nbsp; Cooperative/Collaborative study.</em></li></ul>",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862402,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862404,
                "name": "Radio60",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3862405,
                "name": "Radio79",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3862406,
            "name": "Group8",
            "text": "Please select the appropriate option?",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862404,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862407,
                "name": "Radio80",
                "text": "Reviewing ( TCU is the IRB of Record)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3862408,
                "name": "Radio81",
                "text": "Relying (Non-TCU site serves as IRB of Record)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3862409,
                "name": "Radio82",
                "text": "Sites will submit to their Individual IRBs",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3869442,
            "name": "Group42",
            "text": "Will the study involve collaborators at other institutions who are not engaged in human subject research but will assist in data analysis and/or provide technical assistance?&nbsp;",
            "required": false,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862407,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3869443,
                "name": "Radio72",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3869444,
                "name": "Radio73",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3862410,
            "name": "Group14",
            "text": "Will this submission be a collaborative or cooperative&nbsp;study?",
            "description": "<em>A&nbsp;</em><em><strong>collaborative</strong></em><em><strong>&nbsp;</strong>(or&nbsp;</em><em><strong>cooperative</strong></em><em><strong>)</strong>&nbsp;project involves two or more U.S. research sites, each of which conducts a different part of a research protocol under the direction/control of the lead PI.  An example would be a non-exempt study where TCU is the lead site and conducting the interaction/intervention with the human participants, but the analysis of the data or technical assistance is being done by an external institution/collaborator who will not be engaged (by way of interacting with participants, conducting interventions, or having access to identifiers) in the research.</em>",
            "required": true,
            "helpText": "",
            "compoundType": "radio",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862405,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862411,
                "name": "Radio83",
                "text": "Yes",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              },
              {
                "dataId": 3862412,
                "name": "Radio84",
                "text": "No",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio"
              }
            ]
          },
          {
            "dataId": 3862413,
            "name": "Group31",
            "text": "What type of activity is the submission for?",
            "description": "<em>Please select one option only.</em>",
            "required": true,
            "helpText": "",
            "compoundType": "checkbox",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862412,
                "type": "displayed"
              },
              {
                "targetId": 3862411,
                "type": "displayed"
              },
              {
                "targetId": 3862409,
                "type": "displayed"
              },
              {
                "targetId": 3869443,
                "type": "displayed"
              },
              {
                "targetId": 3869444,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862414,
                "name": "CheckBox36",
                "text": "&nbsp;Human Subjects Determination (Quality Improvement, Program Evaluation etc,)",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862415,
                    "name": "Group27",
                    "text": "Select the appropriate activity for your research.<br>",
                    "required": true,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862414,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862416,
                        "name": "CheckBox27",
                        "text": "<em><strong>Quality Improvement:</strong>&nbsp;This means&nbsp;systematic, data-guided activities designed to bring about immediate, positive changes in the delivery of education or processes in a particular setting. QI involves deliberate actions to improve processes, guided by data reflecting the effects (e.g., types of practical problem solving; an evidence-based management style; the application of the science of how to bring about system change; review of aggregate data at the organizational level to identify a process or management change that can be expected to improvements)</em>. <br><br><em>For QI ? answers to the following questions should be YES:<br><br></em><ul><li><em>Are participants who receive the project intervention expected to benefit?</em></li></ul>  <em><br></em><ul><li><em>Will all groups in the project receive, at the minimum, usual treatment at this institution?</em></li></ul>  <em><br></em><ul><li><em>Is the purpose to measure the performance of or to determine the effect of a process change intended to improve an established process or procedure?</em></li></ul>  <em><br></em><ul><li><em>Will the results be used to inform and implement improvements at the institution the process is being implemented?</em></li></ul>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862417,
                        "name": "CheckBox28",
                        "text": "<em><strong>Program Evaluation:</strong>&nbsp;This refers to assessments of the success of established programs in achieving objectives when the assessments are for the use of program managers, for example, a survey to determine if program beneficiaries are aware of the availability of program services or benefits. [Note: Non-research evaluation is generally designed to assess or improve the program or service rather than to generate knowledge not otherwise known.<br></em>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862418,
                        "name": "CheckBox85",
                        "text": "<em><strong>Secondary Data Analysis:</strong>&nbsp;This refers to the analysis of data that was collected by someone else for another primary purpose. The aggregate data should not contain any identifiers (de-identified), meaning the dataset has been stripped of all identifying information and there is no way it could be linked back to the participants from whom it was originally collected (through a key to a coding system or by other means), its subsequent use by the Principal Investigator or by another researcher would not constitute human subjects research, since the data is no longer identifiable. See&nbsp;</em><a href=\"https://research.tcu.edu/wp-content/uploads/2023/08/Guidance-for-Secondary-Data-Analysis_7.2023.docx\" target=\"_blank\">Guidance for Secondary Data Analysis</a><em><br></em>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862419,
                        "name": "CheckBox29",
                        "text": "<em><strong>Academic Projects:</strong>&nbsp;&nbsp;academic projects or student assignments involving the collection of data from human subjects when the data is used solely for the purpose of learning research methods and not intended to be used to develop or contribute to generalizable knowledge. <strong>Please note: If you believe there is the possibility that the data you collect from this project *may* be submitted to a conference or academic journal(i.e., will contribute to generalizable knowledge), please do not use this form. Submit your protocol as either exempt or expedited.</strong></em><br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862420,
                        "name": "CheckBox30",
                        "text": "<em><strong>Case Reports:</strong>&nbsp;use information collected from a clinical or educational activity rather than a research activity and presented on no more than three (3) participants. Case reports are generally done by retrospective review of the medical record and highlight a unique treatment, case, or outcome. The examination of the case is usually not systematic and there is usually no data analysis or testing of a hypothesis. Investigators must ensure that the HIPAA privacy rules are followed with respect to using or accessing PHI.</em><br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862421,
                        "name": "CheckBox104",
                        "text": "Other",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862422,
                "name": "CheckBox176",
                "text": "Exempt Determination",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              },
              {
                "dataId": 3862423,
                "name": "CheckBox32",
                "text": "Research Study",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862424,
                    "name": "Group24",
                    "text": "TCU Office of Research Compliance&nbsp;adheres to the definitions of human subjects and research found in the&nbsp;<a href=\"https://research.tcu.edu/wp-content/uploads/2019/01/IRB-Review-of-Human-Subject-Research_Procedures.pdf\" target=\"_blank\">IRB Review&nbsp;Human Subject Research&nbsp;Policy</a>.",
                    "description": "",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862423,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862425,
                        "name": "CheckBox6",
                        "text": "<em>Select to see the Definitions of Research and Human Subjects</em>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox",
                        "children": [
                          {
                            "dataId": 3862426,
                            "name": "Label8",
                            "text": "<ul><li><em><strong>Research </strong>- a systematic investigation, including research development, testing, and evaluation, designed to develop or contribute to generalizable knowledge</em></li></ul><em><br></em><ul><li><em><strong>Human Subjects-</strong> a living individual about whom an investigator (whether professional or student) conducting research obtains: (1) Information or biospecimens through intervention or interaction with the individual, and uses studies, or analyzes the information or biospecimens; or (2) Uses, studies, analyzes or generates identifiable private information or identifiable biospecimens.</em></li></ul>",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "label",
                            "dependencies": [
                              {
                                "targetId": 3862425,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "dataId": 3862427,
                        "name": "CheckBox7",
                        "text": "<em>Select to see examples of activities that are considered to be human subjects research.</em><br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox",
                        "children": [
                          {
                            "dataId": 3862428,
                            "name": "Label9",
                            "text": "<ul><li><em>Graduate work such as a thesis or dissertation involving the use of human study participants.</em></li><li><em>Exploratory or feasibility studies involving human feedback or opinion data.</em></li><li><em>Use of a non-public dataset with identifiable data.</em></li><li><em>Data collected for research projects intended for publication or presentation.</em></li></ul>",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "label",
                            "dependencies": [
                              {
                                "targetId": 3862427,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "dataId": 3862429,
        "name": "Section3",
        "text": "Research Personnel",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862423,
            "type": "displayed"
          },
          {
            "targetId": 3862414,
            "type": "displayed"
          },
          {
            "targetId": 3862408,
            "type": "displayed"
          },
          {
            "targetId": 3862401,
            "type": "displayed"
          },
          {
            "targetId": 3862422,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3862430,
            "name": "Label20",
            "text": "<strong>Human Subjects Research Training<br><br></strong>Human subjects training must be completed by all engaged study investigators (including faculty) and non-engaged faculty advisors. This training must be completed prior to submitting a study for initial or continuing review, or when submitting a Modification Submission to a previously approved/exempt certified study. The training requirement can be fulfilled by selecting one via the CITI Program online human subjects research courses. To review what the TCU Office of Research Compliance requires for Human Subject Research Training, please visit the<a href=\"https://research.tcu.edu/research-compliance/irb/irb-training/\" target=\"_blank\"> Human Subjects Training page</a> on our website.<br><br>The following modules are required based on the type of research you will be conducting HSR Social-Behavioral-Educational:<br><br><ul><li>If you will be working with/accessing education records such as records, files, documents, and other materials that are maintained by an educational agency or institution.(FERPA: An Introduction (ID:17407); and FERPA for Researchers (ID:17410))</li><li>If you will be working with any individual involuntarily confined or detained in a penal institution. For additional examples please visit <a href=\"http://hhs.gov/\" target=\"_blank\">HHS.gov</a>. (Research with Prisoners- SBE (ID:506))</li><li>If you will be working with any individuals who have not attained the legal age for consent to treatment or procedures involved in the research. (Research with Children- SBE (ID:507); and Research in Public Elementary and Secondary School- SBE (ID:508))</li><li>If you will be conducting your research in a country outside of the United States.(International Research- SBE (ID:509))</li></ul>The following modules are required based on the type of research you will be conducting HSR-Biomedical:<br><br><ul><li>If you will be conducting any of the following as a part of your research; genetic testing; gene therapy; reproductive genomics; genetic databanks and pharmacogenomics. (Genetic Research in Human Populations (ID: 6))</li><li>If your research involved the use of FDA-approved drugs or devices or any investigational drugs or devices. (FDA-Regulated Research (ID: 12))</li><li>If you will be collecting Protected Health Information, obtaining HIPAA Authorization, or requesting waivers, and how to meet HIPAA requirements. (Research and HIPAA Privacy Protections (ID: 14))</li><li>Workers/employees may be a vulnerable population when they participate in research and the potential risks and benefits associated with research involving workers/employees. (Vulnerable Subjects - Research Involving Workers/Employees (ID: 483))</li><li>Review the assent and informed consent requirements, as well as the current efforts by the FDA to ensure the inclusion of children in studies on the safety and efficacy of new drugs. (Research Involving Children (ID: 9))</li></ul><br><br><br>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "label",
            "children": [
              {
                "dataId": 3862431,
                "name": "Label26",
                "text": "<strong>For PI's:</strong> <br><br>\"Please note once your students have graduated, their names must be removed from the research personnel section. Subsequently, any new students being added must be updated and placed appropriately in the Co-Investigators and/or Other Team Members section. If graduated students continue to serve on the research team, they must undergo the HR process to become a TCU Associate.\".&nbsp;<a href=\"https://hr.tcu.edu/associate-request.php\" target=\"_blank\">https://hr.tcu.edu/associate-request.php</a><br><br>If the study has a community partner who will come on campus to aid in conducting Human Subject Research, they must also complete the HR TCU Associate process (<a href=\"https://hr.tcu.edu/associate-request.php\" target=\"_blank\">https://hr.tcu.edu/associate-request.php</a>)<a href=\"https://hr.tcu.edu/associate-request.php.\" target=\"_blank\">.</a> <br><br>If the PI is going to leave the institution, the PI must transfer the study to another PI via modification or close the study out with the IRB.&nbsp;&nbsp;<a href=\"https://research.tcu.edu/wp-content/uploads/2023/08/Principal-Investigator-Transfer-of-Responsibility-Guidance_7.2023.docx\" target=\"_blank\">https://research.tcu.edu/wp-content/uploads/2023/0...</a><br>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "label"
              }
            ]
          },
          {
            "dataId": 3862432,
            "name": "Group17",
            "text": "<strong>Research Personnel</strong>",
            "description": "",
            "required": false,
            "helpText": "<em>A Principal Investigator or PI is the individual responsible for the preparation, conduct, and administration of a research grant, cooperative agreement, training or public service project, contract, or other sponsored project.</em>",
            "label": "",
            "type": "question"
          },
          {
            "dataId": 3862433,
            "name": "PersonFinder6",
            "text": "<strong>Principal Investigator (PI)</strong>",
            "description": "<strong><em>Use the FIND PEOPLE button below to select <strong>one</strong> TCU-affiliated person to assume primary responsibility for the study.<br><br>NOTE:<br></em></strong><ul><li><em><strong></strong>This person <strong>MUST</strong> be<a href=\"https://research.tcu.edu/wp-content/uploads/2020/06/PI-Eligibility-Policy_clean-6.2020-006.pdf\" target=\"_blank\"> eligible to serve as PI</a>.&nbsp;</em></li><li><em>The PI should be the student's Faculty Sponsor/Mentor for student-initiated work.</em></li><li><em>If you would like to change the PI, use the X to delete the person listed, then use the FIND PEOPLE tool to select a different person.</em></li></ul>",
            "required": true,
            "helpText": "<em>If you cannot find a person using the FIND PEOPLE tool, an account can be requested for them using the TCU IRB (Cayuse Account Request form hyperlink). You can continue filling out this submission, but will not be able to add them using this tool and submit until the account has been created.<br><br>If the information shown for the person added needs updating, send a request to IRBSubmit@tcu.edu.</em><br>",
            "label": "",
            "type": "personfinder",
            "assignmentType": "PRINCIPAL_INVESTIGATOR",
            "hasMultiple": false
          },
          {
            "dataId": 3862434,
            "name": "AttachButton13",
            "text": "If you are a Volunteer Faculty Mentor at TCU Burnett&nbsp;SOM and have completed your Human Subjects CITI training at another institution, you may attach your completion certificate here. It must be current.&nbsp;&nbsp;&nbsp;",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "attachment"
          },
          {
            "dataId": 3862435,
            "name": "TextArea45",
            "text": "Please list the name of the Principal Investigator of the study&nbsp;at&nbsp;the facility where the research will be conducted/ approved.",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "dependencies": [
              {
                "targetId": 3862401,
                "type": "displayed"
              },
              {
                "targetId": 3862401,
                "type": "required"
              }
            ]
          },
          {
            "dataId": 3862436,
            "name": "PersonFinder7",
            "text": "<strong>Co-Investigator(s) (Co-I)</strong>",
            "description": "<em><strong>Use the FIND PEOPLE button below to select the Co-I. To remove the Co-I, select the X in the grid below.<br><br>Note:</strong><br></em><ul><li><em><b style=\"font-weight: bold;\"></b>Student researchers can be selected here; all students must</em><a href=\"https://frogflow.tcu.edu/register/cayuse\" target=\"_blank\"> request access to Cayuse</a>.</li><li>Co-I's can view/read, edit and certify submissions after submission is initially certified by the PI.</li><li><em>Please see the help text if you cannot find the personnel</em></li><li><em>Non-TCU Co-I's will be listed on the collaborative research page</em></li></ul>",
            "required": false,
            "helpText": "<em>If you cannot find a person using the FIND PEOPLE tool, an account can be requested for them using the TCU IRB&nbsp;</em><a href=\"https://frogflow.tcu.edu/register/cayuse\" target=\"_blank\">Cayuse Account Request</a><em>&nbsp;. You can continue filling out this submission, but will not be able to add them using this tool and submit until the account has been created.<br><br>If the information shown for the person added needs updating, send a request to IRBSubmit@tcu.edu.</em>",
            "label": "",
            "type": "personfinder",
            "assignmentType": "CO_PRINCIPAL_INVESTIGATOR",
            "hasMultiple": true
          },
          {
            "dataId": 3862437,
            "name": "PersonFinder1",
            "text": "<strong>Other study team personnel</strong>",
            "description": "Use the FIND PEOPLE button below to select the other study team personnel. To remove personnel select the X in the grid below.<br><br><em><strong>Note: </strong>These individuals are simply listed on the study and can only view/read submissions. They cannot edit or certify submissions.</em>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "personfinder",
            "assignmentType": "INVESTIGATOR",
            "hasMultiple": true
          },
          {
            "dataId": 3862438,
            "name": "PersonFinder8",
            "text": "<strong>Primary Contact</strong>",
            "description": "While the PI and Co-PI will receive all study communications, you may select an additional person that the IRB may communicate with regarding this study. <br><br>By default, the person creating this submission is placed in the Primary Contact role. If you would like to change the Primary Contact use the X to delete the person listed, the use the FIND PEOPLE tool to select a different contact.",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "personfinder",
            "assignmentType": "PRIMARY_CONTACT",
            "hasMultiple": true
          }
        ]
      },
      {
        "dataId": 3862439,
        "name": "Section11",
        "text": "External IRB approval ",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862401,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3862440,
            "name": "TextArea44",
            "text": "<ol><li>Please list where the research will be conducted/ the IRB that provided approval.&nbsp;</li><li> Describe your role in the study if you are not leading it.</li></ol>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "children": [
              {
                "dataId": 3862441,
                "name": "AttachButton16",
                "text": "Please attached all IRB-approved documents (protocol, consent, surveys, etc.)&nbsp;and the IRB approval letter.",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "attachment"
              }
            ]
          }
        ]
      },
      {
        "dataId": 3862442,
        "name": "Section5",
        "text": "Not Research/ Not Human Subject Research Determination Request",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862416,
            "type": "displayed"
          },
          {
            "targetId": 3862417,
            "type": "displayed"
          },
          {
            "targetId": 3862419,
            "type": "displayed"
          },
          {
            "targetId": 3862420,
            "type": "displayed"
          },
          {
            "targetId": 3862418,
            "type": "displayed"
          },
          {
            "targetId": 3862421,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3862443,
            "name": "Label3",
            "text": "<ul><li><em>Answer the questions below to determine if the project meets the federal regulatory definition of human subjects research. </em></li><li><em>See the <a href=\"https://www.hhs.gov/ohrp/regulations-and-policy/decision-charts-2018/index.html\" target=\"_blank\">OHRP decision trees</a>; TCU applies the federal regulations to all research.</em></li><li><em>Please see the&nbsp;</em><a href=\"https://research.tcu.edu/wp-content/uploads/2023/08/NHSR-Guidance-Document-7.2023.docx\" target=\"_blank\">NHSR Guidance Document</a></li><li><strong><a href=\"https://research.tcu.edu/wp-content/uploads/2024/08/Cayuse-2.0-Summary-of-Changes_8.2024.docx\" target=\"_blank\">Cayuse 2.0 Summary of Changes</a></strong></li></ul>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "label"
          },
          {
            "dataId": 3862444,
            "name": "Group1",
            "text": "<strong>Does the project meet the federal definition of Research?</strong>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862445,
                "name": "Group6",
                "text": "<strong>Is the activity an <u>investigation</u>?</strong>",
                "description": "<ul><li><em><u>Investigation</u>: A searching inquiry for facts; detailed or careful examination. </em></li><li><em>A project that starts with a research question is an investigation. </em><em>A literature review does not fit this definition.</em></li></ul>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "children": [
                  {
                    "dataId": 3862446,
                    "name": "Radio3",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  },
                  {
                    "dataId": 3862447,
                    "name": "Radio6",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862448,
                "name": "Group23",
                "text": "<strong>Is the investigation <u>systematic</u>?</strong>",
                "description": "<ul><li><em><u>Systematic</u>: Having or involving a system, method, or plan.</em></li><li><em>This is a plan (methodology) to obtain data to answer a research question.</em></li></ul>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "dependencies": [
                  {
                    "targetId": 3862446,
                    "type": "displayed"
                  }
                ],
                "children": [
                  {
                    "dataId": 3862449,
                    "name": "Radio9",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  },
                  {
                    "dataId": 3862450,
                    "name": "Radio10",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862451,
                "name": "Group26",
                "text": "<strong>Is the systematic investigation designed to <u>develop</u> or <u>contribute</u> to <u>knowledge</u>?</strong>",
                "description": "<ul><li><em><u>Develop</u>: to form the basis for a future contribution.</em></li><li><em><em><u>Contribute</u>: to result in.</em><br></em></li><li><em><em><u>Knowledge</u>: truths, facts, information.</em></em></li><li><em><em>Is it your intent to publish or present the findings?</em></em></li></ul>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "dependencies": [
                  {
                    "targetId": 3862449,
                    "type": "displayed"
                  }
                ],
                "children": [
                  {
                    "dataId": 3862452,
                    "name": "Radio16",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  },
                  {
                    "dataId": 3862453,
                    "name": "Radio17",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862454,
                "name": "Group28",
                "text": "<strong>Is the knowledge the systematic investigation is designed to develop or contribute to <u>generalizable</u>?</strong>",
                "description": "<ul><li><em><u>Generalizable</u>: Universally or widely applicable.</em></li><li><em>Do the findings apply beyond the setting in which they were gathered?</em></li></ul>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "dependencies": [
                  {
                    "targetId": 3862452,
                    "type": "displayed"
                  }
                ],
                "children": [
                  {
                    "dataId": 3862455,
                    "name": "Radio122",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  },
                  {
                    "dataId": 3862456,
                    "name": "Radio123",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862457,
                "name": "Label16",
                "text": "The project qualifies for the determination of <strong>Not Research.</strong><br><br>Please complete the Project Information Section.",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "label",
                "dependencies": [
                  {
                    "targetId": 3862450,
                    "type": "displayed"
                  },
                  {
                    "targetId": 3862453,
                    "type": "displayed"
                  },
                  {
                    "targetId": 3862447,
                    "type": "displayed"
                  },
                  {
                    "targetId": 3862456,
                    "type": "displayed"
                  }
                ]
              }
            ]
          },
          {
            "dataId": 3862458,
            "name": "Group46",
            "text": "<strong>Does the project meet the federal definition of Human Subjects?</strong>",
            "description": "",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862455,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862459,
                "name": "Group95",
                "text": "<strong>Are you gathering data about living individuals?</strong>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "children": [
                  {
                    "dataId": 3862460,
                    "name": "Radio124",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  },
                  {
                    "dataId": 3862461,
                    "name": "Radio125",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862462,
                "name": "Group112",
                "text": "<strong>Will you gather information or a biospecimen through an <u>intervention </u>or an <u>interaction</u>?</strong>",
                "description": "<ul><li><em><u>Intervention</u>: includes both physical procedures by which information or biospecimens are gathered (e.g., venipuncture) and manipulations of the subject or the subject's environment that are performed for research purposes.</em></li><li><em><u>Interaction</u>: includes communication or interpersonal contact between investigator and subject. (Surveys fall under this definition.)</em></li></ul>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "dependencies": [
                  {
                    "targetId": 3862460,
                    "type": "displayed"
                  }
                ],
                "children": [
                  {
                    "dataId": 3862463,
                    "name": "Radio24",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  },
                  {
                    "dataId": 3862464,
                    "name": "Radio127",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862465,
                "name": "Group114",
                "text": "<strong>Will you obtain, use, study, analyze, or generate <u>private information</u>?</strong>",
                "description": "<em>Under some circumstances, research involving only unidentifiable/de-identified or coded private information or biological specimens is research?not human subjects because investigators cannot readily ascertain the identities of the individuals to whom the data or samples belong.</em>",
                "required": false,
                "helpText": "",
                "compoundType": "radio",
                "label": "",
                "type": "question",
                "dependencies": [
                  {
                    "targetId": 3862464,
                    "type": "displayed"
                  }
                ],
                "children": [
                  {
                    "dataId": 3862466,
                    "name": "Radio25",
                    "text": "Yes",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  },
                  {
                    "dataId": 3862467,
                    "name": "Radio129",
                    "text": "No",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "radio"
                  }
                ]
              },
              {
                "dataId": 3862468,
                "name": "Label24",
                "text": "The project meets the federal definition of <strong>Research - Not Human Subjects</strong>. <br>Please complete the Project Information Section.",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "label",
                "dependencies": [
                  {
                    "targetId": 3862467,
                    "type": "displayed"
                  },
                  {
                    "targetId": 3862461,
                    "type": "displayed"
                  }
                ]
              },
              {
                "dataId": 3862469,
                "name": "Label25",
                "text": "This project is <strong>Human Subjects Research</strong>. <br><br>Please change the selection on the Submission Type page to either Exempt Determination or&nbsp;Research Study<br>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "label",
                "dependencies": [
                  {
                    "targetId": 3862463,
                    "type": "displayed"
                  },
                  {
                    "targetId": 3862466,
                    "type": "displayed"
                  }
                ]
              }
            ]
          },
          {
            "dataId": 3862470,
            "name": "TextArea3",
            "text": "<strong>Summary of the Activity(ies)</strong>",
            "description": "Please provide a detailed overview of the proposed activity. Provide sufficient detail for the reviewer:<br><em>Provide a summary of the applicable items:<br><ul><li><em>project topic</em></li><li><em>methodology/process</em></li><li><em>involvement of human participants, if any</em></li><li><em>what data is/was collected, where it originated from, and for what purpose</em></li><li><em>Define all data points that will be collected and describe how the information will be documented for this project</em></li><li><em>Explain how the data will be/was collected OR how data will be transferred/obtained to evaluate data confidentiality or identifiability.</em></li></ul></em>",
            "required": true,
            "helpText": "",
            "label": "",
            "type": "textarea",
            "dependencies": [
              {
                "targetId": 3862467,
                "type": "displayed"
              },
              {
                "targetId": 3862461,
                "type": "displayed"
              },
              {
                "targetId": 3862456,
                "type": "displayed"
              },
              {
                "targetId": 3862447,
                "type": "displayed"
              },
              {
                "targetId": 3862450,
                "type": "displayed"
              },
              {
                "targetId": 3862453,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862471,
                "name": "AttachButton6",
                "text": "If a separate activity description/written plan is available, upload it to this attachment point.&nbsp; Provide all templates that will be used to collect or extract data.",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "attachment"
              }
            ]
          }
        ]
      },
      {
        "dataId": 3862472,
        "name": "Section20",
        "text": "Guided Exempt Determination",
        "label": "",
        "type": "question",
        "dependencies": [
          {
            "targetId": 3862422,
            "type": "displayed"
          }
        ],
        "children": [
          {
            "dataId": 3862473,
            "name": "Label7",
            "text": "To <u>qualify for exemption</u>, <strong>all</strong> human subject research activities and procedures in the study must: <br><br>  <ul><li>Fall into one or more of the exemption categories </li>  <li>NOT involve prisoners* or their existing data and/or specimens UNLESS the research is aimed at involving a broader subject population that only incidentally includes prisoners.</li>  <li>NOT be regulated by the FDA (with the exception of category #6)</li>  <li>NOT be submitted to the FDA for marketing approval </li>  <li>NOT intended to be later submitted to, or held for inspection by, the FDA as part of an application for a research or marketing permit</li></ul>  *<strong>Prisoner</strong> means any individual involuntarily confined or detained in a penal institution.  The term is intended to encompass individuals sentenced to such an institution under a criminal or civil statute, individuals detained in other facilities by virtue of statutes or commitment procedures that provide alternatives to criminal prosecution or incarceration in a penal institution, and individuals detained pending arraignment, trial, or sentencing. [45 CFR 46.303(c)]<br><br>  <strong>Use lay language and spell out acronyms when first mentioned.  Do not cut and paste from or refer the reviewer to a grant, abstract, or syllabus.<br></strong><br>  <strong>Study activities may not be implemented until the investigator receives final written notification from the Office of Research Compliance that&nbsp;the exemption has been granted. <br></strong><br><strong>You may reference the OHRP Decision Charts to help you determine whether your research may be exempt: </strong><a href=\"http://www.hhs.gov/ohrp/policy/checklists/decisioncharts.html\" target=\"_blank\"><strong>http://www.hhs.gov/ohrp/policy/checklists/decisioncharts.html</strong></a><br>",
            "required": false,
            "helpText": "",
            "label": "",
            "type": "label"
          },
          {
            "dataId": 3862474,
            "name": "Group40",
            "text": "<strong>Exempt Categories&nbsp;</strong>",
            "description": "There are <strong>eight (8)</strong> exemption categories. However, at this time, TCU IRB does not review research that falls under categories 7 and 8. <strong><u>ALL</u></strong> research activities and/or procedures involving human subjects must fall within one or more categories below to be exempt.&nbsp;<br><br>The HRPP/IRB&nbsp;is ultimately responsible for deciding if research qualifies for exemption; however, investigators are asked to make an initial determination of the appropriate exemption category.<br><br><strong><a href=\"https://research.tcu.edu/wp-content/uploads/2024/08/Cayuse-2.0-Summary-of-Changes_8.2024.docx\" target=\"_blank\">Cayuse 2.0 Summary of Changes</a></strong><br><br><strong><u>Select the appropriate category or categories that apply to the research activities/procedures and answer the questions included within that category to ensure the study meets exempt criteria.</u></strong><br><br>",
            "required": false,
            "helpText": "",
            "compoundType": "checkbox",
            "label": "",
            "type": "question",
            "children": [
              {
                "dataId": 3862475,
                "name": "CheckBox187",
                "text": "<strong><u>Category 1<br></u></strong><br>  Research, conducted in established or commonly accepted educational settings, that specifically involves normal educational practices that are not likely to adversely impact students? opportunity to learn required educational content or the assessment of educators who provide instruction. This includes most research on regular and special education instructional strategies, and research on the effectiveness of or the comparison among instructional techniques, curricula, or classroom management methods.<br><br>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862476,
                    "name": "TextArea84",
                    "text": "<ol><li>Explain why the setting is considered an established or commonly accepted education setting.</li><li>Explain why this research involves normal educational practices.</li></ol>",
                    "required": false,
                    "helpText": "45 CFR 46 does not specify that normal educational practice takes place in schools only.  The IRB defines an educational setting as any setting where an educational experience takes place.  For example, a public school, an after-school club or program, a Boy or Girl Scout meeting, a professional development seminar for school district personnel, or a postsecondary education setting.<br><br>The IRB considers educational time to be a valuable commodity, and thus, the design of a research study that will be carried out in an educational setting should be developed with this in mind.  At the minimum, the research should not waste student educational time, and may offer benefit to the individual and/or classwide educational experience.  The IRB will consider the proposed methodology for the study in light of both time requirements and likelihood of benefit in order to determine whether it qualifies as normal educational practice.  In all cases, the IRB will need to assess risks to all proposed participants in the study to determine the level of review required.<br>In some cases, it may be helpful if the PI can provide a letter verifying that the appropriate school administrator (e.g, principal, superintendent, school board) considers the proposed research study to be normal educational practice. <br>",
                    "label": "",
                    "type": "textarea",
                    "dependencies": [
                      {
                        "targetId": 3862475,
                        "type": "displayed"
                      }
                    ]
                  },
                  {
                    "dataId": 3862477,
                    "name": "Group54",
                    "text": "Is this research likely to adversely impact students? opportunity to learn required educational content?",
                    "required": false,
                    "helpText": "",
                    "compoundType": "radio",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862475,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862478,
                        "name": "Radio7",
                        "text": "Yes",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio",
                        "children": [
                          {
                            "dataId": 3862479,
                            "name": "Label10",
                            "text": "If YES, this exemption does not apply. <strong>Please go back to the Submission type page and change your selection to Research Study.</strong><br>",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "label",
                            "dependencies": [
                              {
                                "targetId": 3862478,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "dataId": 3862480,
                        "name": "Radio8",
                        "text": "No",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio"
                      }
                    ]
                  },
                  {
                    "dataId": 3862481,
                    "name": "Group68",
                    "text": "Is this research likely to adversely impact the assessment of educators who provide instruction?",
                    "required": false,
                    "helpText": "",
                    "compoundType": "radio",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862480,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862482,
                        "name": "Radio14",
                        "text": "Yes",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio",
                        "children": [
                          {
                            "dataId": 3862483,
                            "name": "Label11",
                            "text": "If YES, this exemption does not apply. <strong>Please go back to the Submission type page and change your selection to Research Study.</strong>",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "label",
                            "dependencies": [
                              {
                                "targetId": 3862482,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "dataId": 3862484,
                        "name": "Radio15",
                        "text": "No",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862485,
                "name": "CheckBox188",
                "text": "<strong><u>Category 2</u></strong><br>Research that only includes interactions involving the use of educational tests (cognitive, diagnostic, aptitude, achievement), survey procedures, interview procedures, or observation of public behavior (including visual or auditory recording) if <strong>at least one</strong> of the following criteria is&nbsp;met.<br><br><br>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862486,
                    "name": "Group101",
                    "text": "(please check one):",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862485,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862487,
                        "name": "CheckBox189",
                        "text": "(i) The investigator records the information obtained in such a manner that the identity of the human subjects cannot readily be ascertained, directly or through identifiers linked to the subjects; <strong>OR</strong><br><br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862488,
                        "name": "CheckBox190",
                        "text": "(ii) Any disclosure of the human subjects? responses outside the research would not reasonably place the subjects at risk of criminal or civil liability or be damaging to the subjects? financial standing, employability, educational advancement, or reputation; <strong>OR</strong><br><br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862489,
                        "name": "CheckBox191",
                        "text": "(iii) The information obtained is recorded by the investigator in such a manner that the identity of the human subjects can readily be ascertained, directly or through identifiers linked to the subjects, and an IRB conducts a limited IRB review to make the determination required by 45 CFR 46.111(a)(7).<br><br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  },
                  {
                    "dataId": 3862490,
                    "name": "Group102",
                    "text": "Indicate which research activities are taking place:<br>",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862487,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862488,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862489,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862491,
                        "name": "CheckBox192",
                        "text": "Educational tests (cognitive, diagnostic,aptitude, achievement)",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862492,
                        "name": "CheckBox193",
                        "text": "Survey procedures<br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862493,
                        "name": "CheckBox194",
                        "text": "Interview procedures",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862494,
                        "name": "CheckBox195",
                        "text": "Observation of public behavior",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox",
                        "children": [
                          {
                            "dataId": 3862495,
                            "name": "Group103",
                            "text": "Select as applicable",
                            "required": false,
                            "helpText": "",
                            "compoundType": "checkbox",
                            "label": "",
                            "type": "question",
                            "dependencies": [
                              {
                                "targetId": 3862494,
                                "type": "displayed"
                              }
                            ],
                            "children": [
                              {
                                "dataId": 3862496,
                                "name": "CheckBox196",
                                "text": "Audio Recording",
                                "required": false,
                                "helpText": "",
                                "label": "",
                                "type": "checkbox"
                              },
                              {
                                "dataId": 3862497,
                                "name": "CheckBox197",
                                "text": "Visual Recording",
                                "required": false,
                                "helpText": "",
                                "label": "",
                                "type": "checkbox"
                              },
                              {
                                "dataId": 3862498,
                                "name": "CheckBox198",
                                "text": "N/A",
                                "required": false,
                                "helpText": "",
                                "label": "",
                                "type": "checkbox"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "dataId": 3862499,
                    "name": "Group105",
                    "text": "Does this research involve children?",
                    "required": false,
                    "helpText": "",
                    "compoundType": "radio",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862491,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862492,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862493,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862496,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862497,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862498,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862500,
                        "name": "Radio21",
                        "text": "Yes",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio",
                        "children": [
                          {
                            "dataId": 3862501,
                            "name": "Label12",
                            "text": "If yes, exemption under categories 2(i) and 2(ii) is limited to educational tests and the observation of public behaviors where the investigator (s) will NOT participate in the activities being observed. <br><br>Category 2(iii) may not be applied to research with children.&nbsp;<br><strong>If children will be the target population, please return to the Submission Type page and change your selection to Research Study.</strong>",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "label",
                            "dependencies": [
                              {
                                "targetId": 3862500,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "dataId": 3862502,
                        "name": "Radio22",
                        "text": "No",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862503,
                "name": "CheckBox200",
                "text": "<strong><u>Category 3<br></u></strong><br>  Research involving benign behavioral interventions* in conjunction with the collection of information from an adult subject through verbal or written responses (including data entry) or audiovisual recording if the subject prospectively agrees to the intervention and information collection and <strong>at least one</strong> of the following criteria is met.<br><br><em>*For the purpose of this exemption, <strong>benign behavioral interventions</strong> are brief in duration, harmless, painless, not physically invasive, not likely to have a significant adverse lasting impact on the subjects, and the investigator has no reason to think the subjects will find the interventions offensive or embarrassing. Provided all such criteria are met, examples of such benign behavioral interventions would include having the subjects play an online game, having them solve puzzles under various noise conditions, or having them decide how to allocate a nominal amount of received cash between themselves and someone else.<br><br><strong>NOTE</strong>: Research involving children is not eligible for this exemption.<br></em><br>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862504,
                    "name": "Group106",
                    "text": "Please check one:",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862503,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862505,
                        "name": "CheckBox201",
                        "text": "(A) The information obtained is recorded by the investigator in such a manner that the identity of the human subjects cannot readily be ascertained, directly or through identifiers linked to the subjects;&nbsp;<strong>OR</strong>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862506,
                        "name": "CheckBox202",
                        "text": "(B) Any disclosure of the human subjects responses outside the research would not reasonably place the subjects at risk of criminal or civil liability or be damaging to the subjects? financial standing, employability, educational advancement, or reputation; <strong>OR</strong>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862507,
                        "name": "CheckBox203",
                        "text": "(C) The information obtained is recorded by the investigator in such a manner that the identity of the human subjects can readily be ascertained, directly or through identifiers linked to the subjects, and an IRB conducts a limited IRB review to make the determination required by 45 CFR 46.111(a)(7). <br><br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  },
                  {
                    "dataId": 3862508,
                    "name": "Group107",
                    "text": "Will this research involve <u>deceiving</u> the participants regarding the nature or purposes of the research? (This includes ?incomplete disclosure.?)<br>",
                    "required": false,
                    "helpText": "",
                    "compoundType": "radio",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862505,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862506,
                        "type": "displayed"
                      },
                      {
                        "targetId": 3862507,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862509,
                        "name": "Radio23",
                        "text": "Yes",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio",
                        "children": [
                          {
                            "dataId": 3862510,
                            "name": "Label14",
                            "text": "*If yes, the subject <strong>MUST</strong> authorize the deception through prospective agreement to participate in research in circumstances in which the participant is informed that they will be unaware of or misled regarding the nature or purposes of the research. This information is generally contained in the consent form.<br>",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "label",
                            "dependencies": [
                              {
                                "targetId": 3862509,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "dataId": 3862511,
                        "name": "Radio49",
                        "text": "No",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862512,
                "name": "CheckBox204",
                "text": "<strong><u>Category 4<br></u></strong><br>Secondary research for which consent is not required: Secondary research uses identifiable private information or identifiable biospecimens if at least one of the following criteria is met.<br><br>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862513,
                    "name": "Group108",
                    "text": "Please check one:",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862512,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862514,
                        "name": "CheckBox205",
                        "text": "(i) The identifiable private information or identifiable biospecimens are publicly available (<em>Publicly available&nbsp;</em>means that the general public could obtain the data or specimens. If access is limited to research, data/specimens are not considered publicly available.); <strong>OR</strong>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862515,
                        "name": "CheckBox206",
                        "text": "(ii) Information, which may include information about biospecimens, is recorded by the investigator in such a manner that the identity of the human subjects cannot readily be ascertained directly or through identifiers linked to the subjects; the investigator does not contact the subjects, and the investigator will not re-identify subjects; <strong>OR</strong>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862516,
                        "name": "CheckBox207",
                        "text": "(iii) The research involves only information collection and analysis involving the investigator?s use of identifiable health information when that use is regulated under 45 CFR parts 160 and 164, subparts A and E (HIPAA Privacy Rule), for the purposes of ?health care operations? or ?research? as those terms are defined at 45 CFR 164.501 or for ?public health activities and purposes? as described under 45 CFR 164.512(b); <strong>OR</strong>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862517,
                        "name": "CheckBox208",
                        "text": "(iv) The research is conducted by, or on behalf of, a Federal department or agency using government-generated or government-collected information obtained for nonresearch activities, if the research generates identifiable private information that is or will be maintained on information technology that is subject to and in compliance with section 208(b) of the E-Government Act of 2002, 44 U.S.C. 3501 note, if all of the identifiable private information collected, used, or generated as part of the activity will be maintained in systems of records subject to the Privacy Act of 1974, 5 U.S.C. 552a, and, if applicable, the information used in the research, was collected subject to the Paperwork Reduction Act of 1995, 44 U.S.C. 3501 et seq.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862518,
                "name": "CheckBox186",
                "text": "<strong><u>Category 5</u></strong><br>Research and demonstration projects that are conducted or supported by a Federal department or agency or otherwise subject to the approval of department or agency heads (or the approval of the heads of bureaus or other subordinate agencies that have been delegated authority to conduct the research and demonstration projects), and that are designed to study, evaluate, improve, or otherwise examine public benefit or service programs, including procedures for obtaining benefits or services under those programs, possible changes in or alternatives to those programs or procedures, or possible changes in methods or levels of payment for benefits or services under those programs. Such projects include, but are not limited to, internal studies by Federal employees and studies under contracts or consulting arrangements, cooperative agreements, or grants. Exempt projects also include waivers of otherwise mandatory requirements using authorities such as sections 1115 and 1115A of the Social Security Act, as amended.<br><br>(i) Each Federal department or agency conducting or supporting the research and demonstration projects must establish, on a publicly accessible Federal website or in such other manner as the department or agency head may determine, a list of the research and demonstration projects that the Federal department or agency conducts or supports under this provision. The research or&nbsp;demonstration project must be published on this list prior to commencing the research involving human subjects.<br><br>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862519,
                    "name": "TextBox31",
                    "text": "Provide the web address where this research project is listed. If there is no website, provide information on how the federal&nbsp;department/agency publishes this information:",
                    "required": false,
                    "helpText": "",
                    "label": "",
                    "type": "textbox",
                    "dependencies": [
                      {
                        "targetId": 3862518,
                        "type": "displayed"
                      }
                    ]
                  }
                ]
              },
              {
                "dataId": 3862520,
                "name": "CheckBox199",
                "text": "<strong><u>Category 6</u></strong><br>Taste and food quality evaluation and consumer acceptance studies, (i) if wholesome foods without additives are consumed or (ii) if a food is consumed that contains a food ingredient at or below the level and for a use found to be safe, or agricultural chemical or environmental contaminant at or below the level found to be safe, by the Food and Drug Administration or approved by the Environmental Protection Agency or the Food Safety and Inspection Service of the U.S. Department of Agriculture.<br>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862521,
                    "name": "Group104",
                    "text": "",
                    "description": "Does this research involve a taste and food quality evaluation and/or consumer acceptance studies?",
                    "required": false,
                    "helpText": "",
                    "compoundType": "radio",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862520,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862522,
                        "name": "Radio50",
                        "text": "Yes",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio"
                      },
                      {
                        "dataId": 3862523,
                        "name": "Radio57",
                        "text": "No",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "radio",
                        "children": [
                          {
                            "dataId": 3862524,
                            "name": "Label28",
                            "text": "<strong>Please return to the Submission Type page, uncheck exempt determination, and then check off the Research study.</strong>",
                            "required": false,
                            "helpText": "",
                            "label": "",
                            "type": "label",
                            "dependencies": [
                              {
                                "targetId": 3862523,
                                "type": "displayed"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "dataId": 3862525,
                    "name": "Group109",
                    "text": "Indicate all activities taking place:<br>",
                    "required": false,
                    "helpText": "",
                    "compoundType": "checkbox",
                    "label": "",
                    "type": "question",
                    "dependencies": [
                      {
                        "targetId": 3862522,
                        "type": "displayed"
                      }
                    ],
                    "children": [
                      {
                        "dataId": 3862526,
                        "name": "CheckBox209",
                        "text": "Only wholesome foods without additives will beconsumed.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862527,
                        "name": "CheckBox210",
                        "text": "The food consumed will contain a food ingredient that is at or below the level found to be safe and is for use found to be safe.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862528,
                        "name": "CheckBox211",
                        "text": "Food will be consumed that contains an agricultural chemical or environmental contaminant at or below the level found to be safe by the FDA.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862529,
                        "name": "CheckBox212",
                        "text": "Food will be consumed that contains an agricultural chemical or environmental contaminant that is at or below the level approved by the EPA.&nbsp;<br>",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      },
                      {
                        "dataId": 3862530,
                        "name": "CheckBox213",
                        "text": "Food will be consumed that contains an agricultural chemical or environmental contaminant that is at or below the level approved by the Food Safety and Inspection Service of the Department of Agriculture.",
                        "required": false,
                        "helpText": "",
                        "label": "",
                        "type": "checkbox"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "dataId": 3862531,
            "name": "Group97",
            "text": "<strong>Chart Reivew</strong>",
            "description": "There are different categories of Exempt status for research studies. Chart reviews generally fall under Exempt Category 4(ii) or 4(iii). These are:<br><br><ol><li><em>4(ii) Secondary research uses identifiable private information or identifiable biospecimen information recorded by the investigator in a manner that makes the identity of subjects difficult to ascertain.</em></li><li><em>4(iii) Secondary research uses of identifiable private information or identifiable biospecimen or use of identifiable information regulated under HIPAA</em></li></ol>Note that the data to be collected for a chart review is considered a use of identifiable private information.? Because medical records exist for clinical and not research purposes, the use of this data for research is considered a secondary use.<br><br>The choice between Exempt Category 4(ii) and 4(iii) depends on whether you will collect identifiers (such as MRN) as part of your study.",
            "required": true,
            "helpText": "",
            "compoundType": "checkbox",
            "label": "",
            "type": "question",
            "dependencies": [
              {
                "targetId": 3862515,
                "type": "displayed"
              },
              {
                "targetId": 3862516,
                "type": "displayed"
              }
            ],
            "children": [
              {
                "dataId": 3862532,
                "name": "CheckBox131",
                "text": "Confirm the chart review study is&nbsp;retrospective.<br><br><em><strong>If there is a prospective component to the study, please return to the Submission Type page, uncheck the Exempt Determination option, and check the Research Study option.&nbsp;&nbsp;</strong></em>",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "checkbox"
              }
            ]
          },
