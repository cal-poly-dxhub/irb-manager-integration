                "children": [
                  {
                    "dataId": 3862558,
                    "name": "TextBox33",
                    "text": "<em>Please list who will serve as the point of contact who will distribute your recruitment material.</em>",
                    "description": "<em><strong>NOTE: </strong>For research in which non-study team members distribute recruitment messages on behalf of the study team (e.g., distribution on a listserve, \"snowball\" sampling, etc.), it is recommended that those individuals pass along a message that includes study team member contact information. In this way, interested individuals (potential subjects) can initiate contact without having their private information exchanged without their specific consent.</em>",
                    "required": false,
