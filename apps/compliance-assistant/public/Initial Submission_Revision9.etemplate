                "type": "checkbox",
                "children": [
                  {
                    "dataId": 3862535,
                    "name": "TextBox28",
                    "text": "Please provide the exact location on-campus where study procedures will take place.",
                    "required": false,
                    "helpText": "",
                    "label": "",
