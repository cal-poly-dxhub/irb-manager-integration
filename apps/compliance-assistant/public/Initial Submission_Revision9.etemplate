                "type": "radio"
              },
              {
                "dataId": 3862969,
                "name": "Radio86",
                "text": "The protocol will NOT be conducted at the same at some or all sites.&nbsp;",
                "required": false,
                "helpText": "",
                "label": "",
                "type": "radio",
                "children": [
                  {
                    "dataId": 3862970,
                    "name": "Group18",
